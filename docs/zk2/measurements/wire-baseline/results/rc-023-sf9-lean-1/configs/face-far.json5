// The far end's transport, generated by `zenctl acl gen --far-config` (link.v2 §2.18):
// the far router's config, or the gateway client's session config, across face lora (far ground).
// The transport the far end runs (link.v2 §2.16, §2.18), from the face policy.
// zenoh reads it once per process, for every link it holds. Merge it into the
// config's own `transport` (auth, TLS) by hand: a JSON5 object holds one `transport`
// key. Both ends run one lease and keep_alive, which are not negotiated: `zenctl check
// face --peer-config` compares this one with the router's.
transport: {
  link: {
    tx: {
      lease: 480000,  // ms; a keep-alive every 120000 ms when idle
      keep_alive: 4,
      sequence_number_resolution: "16bit",
      batch_size: 117,
      queue: { congestion_control: { block: { wait_before_close: 480000000 } } },  // µs, at least the lease
    },
  },
  unicast: { open_timeout: 10000, accept_timeout: 10000 },  // ms
  // The far principal's credentials (link.v2 §2.5): zenoh's usrpwd authenticates the end
  // that opens a link to the end that accepts it, never the other way, so the far end opens the
  // face's links as "ground". Fill in its password, the one the near router's dictionary
  // holds for it, and the far end's own dictionary_file: with credentials, the far end asks a user of
  // every session that opens to it, and refuses one the file does not hold. Give each
  // session of the far side a user of its own there, its local tools among them.
  // Unfilled, each part fails its own way (link.v2 §2.18). zenoh opens no dictionary it
  // cannot read, so the far end does not start from this block as written. With the
  // dictionary filled in and the password not, it starts, and the near router refuses its
  // link: it presents the placeholder as its password, or no user at all once the password
  // is removed, since zenoh loads no user without one.
  auth: { usrpwd: { user: "ground", password: "<ground's password>", dictionary_file: "<the far end's dictionary>" } },
},
routing: { interests: { timeout: 10000 } },  // ms
// zenoh stamps every unstamped put a router routes, and the stamp crosses the face:
// the far end stamps none, in either mode (core §8.2, link.v2 §2.18).
timestamping: { enabled: { router: false, peer: false } },
