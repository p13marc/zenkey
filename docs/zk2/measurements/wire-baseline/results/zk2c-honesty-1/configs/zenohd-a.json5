{
  // #989's router A (RF, rf()'s profile, link.v2's transport, bare stack), rendered by
  // render.py from configs/zenohd.json5.in. A copy of zenoh-modem's
  // configs/zenohd-rf0.json5 (d8c62df), edited for a measurement of today's
  // zk2 wire:
  // - the TCP face and the lane socket are this run's;
  // - NO lane-face access_control and no downsampling: "today" is everything
  //   zk2's rules make travel (constrained-overhead-review.md §2.2). #989's
  //   zk2c runs on a face put rf0's plan on router A instead (render.py --face);
  // - batch_size is the driver's zenoh_batch_size; lease and keep_alive are
  //   zenohd-rf0.face.toml's [transport] (link.v2 §2.16);
  // - wait_before_close is at least the lease, as rf0's comment requires;
  // - mode: a link.v2 face (rf0's plan, acl gen --face-policy): a router, the far side attached to it, the plan's subjects by user name.
  // zk2 clients attach to the TCP face.
  mode: "router",

  // A listens where driver A dials (its endpoint "b", role "dial"): the far side
  // opens the transport, and this router authenticates it.
  listen: { endpoints: ["tcp/127.0.0.1:17601", "unixsock-stream//srv/dev/targets/zenkey-989/run/honesty/a/rfa/b/air?rel=0;prio=0-7#so_sndbuf=1"] },

  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false },
  },

  routing: { interests: { timeout: 10000 } },

  // core §8.2: a router forwarding onto a constrained face stamps nothing
  timestamping: { enabled: { router: false } },
// The face's access control, as acl gen wrote it.
access_control: {
  enabled: true,
  default_permission: "deny",  // §11.2: grants compile to allow rules (RECOMMENDED)
  rules: [
    // own (h-3fa9c2d41b7e/rf0): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:h-3fa9c2d41b7e/rf0", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/**", "zk2/h-3fa9c2d41b7e/rf0/*/@stream/**", "zk2/h-3fa9c2d41b7e/rf0/*/@state/**", "zk2/h-3fa9c2d41b7e/rf0/*/@op/**", "zk2/h-3fa9c2d41b7e/rf0/@zk/**"] },
    // own (h-3fa9c2d41b7e/rf0): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:h-3fa9c2d41b7e/rf0", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/**", "zk2/h-3fa9c2d41b7e/rf0/*/@stream/**", "zk2/h-3fa9c2d41b7e/rf0/*/@state/**", "zk2/h-3fa9c2d41b7e/rf0/*/@op/**", "zk2/h-3fa9c2d41b7e/rf0/@zk/**"] },
    // own (h-c2a95e41d7f0/lora0): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:h-c2a95e41d7f0/lora0", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/h-c2a95e41d7f0/lora0/**", "zk2/h-c2a95e41d7f0/lora0/*/@stream/**", "zk2/h-c2a95e41d7f0/lora0/*/@state/**", "zk2/h-c2a95e41d7f0/lora0/*/@op/**", "zk2/h-c2a95e41d7f0/lora0/@zk/**"] },
    // own (h-c2a95e41d7f0/lora0): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:h-c2a95e41d7f0/lora0", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/h-c2a95e41d7f0/lora0/**", "zk2/h-c2a95e41d7f0/lora0/*/@stream/**", "zk2/h-c2a95e41d7f0/lora0/*/@state/**", "zk2/h-c2a95e41d7f0/lora0/*/@op/**", "zk2/h-c2a95e41d7f0/lora0/@zk/**"] },
    // own (h-71c0e2a9d4b3/sat0): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:h-71c0e2a9d4b3/sat0", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/h-71c0e2a9d4b3/sat0/**", "zk2/h-71c0e2a9d4b3/sat0/*/@stream/**", "zk2/h-71c0e2a9d4b3/sat0/*/@state/**", "zk2/h-71c0e2a9d4b3/sat0/*/@op/**", "zk2/h-71c0e2a9d4b3/sat0/@zk/**"] },
    // own (h-71c0e2a9d4b3/sat0): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:h-71c0e2a9d4b3/sat0", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/h-71c0e2a9d4b3/sat0/**", "zk2/h-71c0e2a9d4b3/sat0/*/@stream/**", "zk2/h-71c0e2a9d4b3/sat0/*/@state/**", "zk2/h-71c0e2a9d4b3/sat0/*/@op/**", "zk2/h-71c0e2a9d4b3/sat0/@zk/**"] },
    // consume (tool.console): §11.1 Consume: subscribe or GET on what the bindings name, one selector per bound provider (R1), R2's parameter bindings applied, and (0.86) each bound provider's heartbeat covering a bound interface that uses freshness.v2, where the binding consumes one of its collections (§7.5, freshness.v2 §2.5)
    { id: "consume-in:tool.console", permission: "allow", flows: ["ingress"],
      messages: ["declare_subscriber", "query"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/events/**", "zk2/h-3fa9c2d41b7e/rf0/config.v1/state/**", "zk2/h-3fa9c2d41b7e/rf0/freshness.v2/stream/heartbeat/config.v1", "zk2/h-c2a95e41d7f0/lora0/config.v1/events/**", "zk2/h-c2a95e41d7f0/lora0/config.v1/state/**", "zk2/h-c2a95e41d7f0/lora0/freshness.v2/stream/heartbeat/config.v1", "zk2/h-71c0e2a9d4b3/sat0/config.v1/events/**", "zk2/h-71c0e2a9d4b3/sat0/config.v1/state/**", "zk2/h-71c0e2a9d4b3/sat0/freshness.v2/stream/heartbeat/config.v1", "zk2/h-3fa9c2d41b7e/rf0/health.v1/state/**", "zk2/h-3fa9c2d41b7e/rf0/health.v1/stream/**", "zk2/h-3fa9c2d41b7e/rf0/freshness.v2/stream/heartbeat/health.v1", "zk2/h-c2a95e41d7f0/lora0/health.v1/state/**", "zk2/h-c2a95e41d7f0/lora0/health.v1/stream/**", "zk2/h-c2a95e41d7f0/lora0/freshness.v2/stream/heartbeat/health.v1", "zk2/h-71c0e2a9d4b3/sat0/health.v1/state/**", "zk2/h-71c0e2a9d4b3/sat0/health.v1/stream/**", "zk2/h-71c0e2a9d4b3/sat0/freshness.v2/stream/heartbeat/health.v1", "zk2/h-3fa9c2d41b7e/rf0/modem.v3/events/**", "zk2/h-3fa9c2d41b7e/rf0/modem.v3/state/**", "zk2/h-3fa9c2d41b7e/rf0/modem.v3/stream/**", "zk2/h-3fa9c2d41b7e/rf0/freshness.v2/stream/heartbeat/modem.v3", "zk2/h-c2a95e41d7f0/lora0/modem.v3/events/**", "zk2/h-c2a95e41d7f0/lora0/modem.v3/state/**", "zk2/h-c2a95e41d7f0/lora0/modem.v3/stream/**", "zk2/h-c2a95e41d7f0/lora0/freshness.v2/stream/heartbeat/modem.v3", "zk2/h-71c0e2a9d4b3/sat0/modem.v3/events/**", "zk2/h-71c0e2a9d4b3/sat0/modem.v3/state/**", "zk2/h-71c0e2a9d4b3/sat0/modem.v3/stream/**", "zk2/h-71c0e2a9d4b3/sat0/freshness.v2/stream/heartbeat/modem.v3"] },
    // consume (tool.console): §11.1 Consume, egress: the samples and replies those selectors receive
    { id: "consume-out:tool.console", permission: "allow", flows: ["egress"],
      messages: ["put", "delete", "reply"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/events/**", "zk2/h-3fa9c2d41b7e/rf0/config.v1/state/**", "zk2/h-3fa9c2d41b7e/rf0/freshness.v2/stream/heartbeat/config.v1", "zk2/h-c2a95e41d7f0/lora0/config.v1/events/**", "zk2/h-c2a95e41d7f0/lora0/config.v1/state/**", "zk2/h-c2a95e41d7f0/lora0/freshness.v2/stream/heartbeat/config.v1", "zk2/h-71c0e2a9d4b3/sat0/config.v1/events/**", "zk2/h-71c0e2a9d4b3/sat0/config.v1/state/**", "zk2/h-71c0e2a9d4b3/sat0/freshness.v2/stream/heartbeat/config.v1", "zk2/h-3fa9c2d41b7e/rf0/health.v1/state/**", "zk2/h-3fa9c2d41b7e/rf0/health.v1/stream/**", "zk2/h-3fa9c2d41b7e/rf0/freshness.v2/stream/heartbeat/health.v1", "zk2/h-c2a95e41d7f0/lora0/health.v1/state/**", "zk2/h-c2a95e41d7f0/lora0/health.v1/stream/**", "zk2/h-c2a95e41d7f0/lora0/freshness.v2/stream/heartbeat/health.v1", "zk2/h-71c0e2a9d4b3/sat0/health.v1/state/**", "zk2/h-71c0e2a9d4b3/sat0/health.v1/stream/**", "zk2/h-71c0e2a9d4b3/sat0/freshness.v2/stream/heartbeat/health.v1", "zk2/h-3fa9c2d41b7e/rf0/modem.v3/events/**", "zk2/h-3fa9c2d41b7e/rf0/modem.v3/state/**", "zk2/h-3fa9c2d41b7e/rf0/modem.v3/stream/**", "zk2/h-3fa9c2d41b7e/rf0/freshness.v2/stream/heartbeat/modem.v3", "zk2/h-c2a95e41d7f0/lora0/modem.v3/events/**", "zk2/h-c2a95e41d7f0/lora0/modem.v3/state/**", "zk2/h-c2a95e41d7f0/lora0/modem.v3/stream/**", "zk2/h-c2a95e41d7f0/lora0/freshness.v2/stream/heartbeat/modem.v3", "zk2/h-71c0e2a9d4b3/sat0/modem.v3/events/**", "zk2/h-71c0e2a9d4b3/sat0/modem.v3/state/**", "zk2/h-71c0e2a9d4b3/sat0/modem.v3/stream/**", "zk2/h-71c0e2a9d4b3/sat0/freshness.v2/stream/heartbeat/modem.v3"] },
    // presence (tool.console): §11.1 Consume, Call and Tool (0.8, 0.14, 0.27), §8.1, §3.3: liveliness reads and the descriptor's GET and subscription on the `@zk` subtree of each service bound, called or inspected. A refused read is answered complete and empty, so a reader the grants refuse would attribute silence to absence (§11.3)
    { id: "presence-in:tool.console", permission: "allow", flows: ["ingress"],
      messages: ["declare_liveliness_subscriber", "liveliness_query", "query", "declare_subscriber"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/@zk/**", "zk2/h-c2a95e41d7f0/lora0/@zk/**", "zk2/h-71c0e2a9d4b3/sat0/@zk/**"] },
    // presence (tool.console): §11.1 (0.8, 0.14, 0.27), §8.1, §3.3, egress: the tokens and the descriptors those reads receive
    { id: "presence-out:tool.console", permission: "allow", flows: ["egress"],
      messages: ["liveliness_token", "reply", "put"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/@zk/**", "zk2/h-c2a95e41d7f0/lora0/@zk/**", "zk2/h-71c0e2a9d4b3/sat0/@zk/**"] },
    // call (tool.console): §11.1 Call: query on the specific `…/@op/<op>` keys called
    { id: "call-in:tool.console", permission: "allow", flows: ["ingress"],
      messages: ["query"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/cancel", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/confirm", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/extend", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/persist", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/*", "zk2/h-c2a95e41d7f0/lora0/config.v1/@op/cancel", "zk2/h-c2a95e41d7f0/lora0/config.v1/@op/confirm", "zk2/h-c2a95e41d7f0/lora0/config.v1/@op/extend", "zk2/h-c2a95e41d7f0/lora0/config.v1/@op/persist", "zk2/h-c2a95e41d7f0/lora0/config.v1/@op/set/*", "zk2/h-71c0e2a9d4b3/sat0/config.v1/@op/cancel", "zk2/h-71c0e2a9d4b3/sat0/config.v1/@op/confirm", "zk2/h-71c0e2a9d4b3/sat0/config.v1/@op/extend", "zk2/h-71c0e2a9d4b3/sat0/config.v1/@op/persist", "zk2/h-71c0e2a9d4b3/sat0/config.v1/@op/set/*"] },
    // call (tool.console): §11.1 Call, egress: the replies, a server's refusal included (O2, O3)
