# The zk2 spike's recipes (#591). Run from the repository root with
# `just -f spike/justfile <recipe>`, or from spike/. Each spike-<group>
# recipe writes CSV rows and a markdown summary under results/<group>/.
# Release builds only: numbers from a debug build are not numbers.

set working-directory := "."

spike := "target/release/spike"

# The example contracts the mock services implement (#608, #589).
contracts := "../examples/zk2/walkthrough/*.toml ../examples/zk2/tcgui/tc.*.toml"

build:
    cargo build --release -p spike

# Two routers, 10 mock services from the example contracts, one client:
# presence, a descriptor, a contract by hash, a state GET, a call, one row.
spike-smoke services="10": build
    {{spike}} smoke --services {{services}} --results results/smoke {{contracts}}

# S1, grammar basics (#597): round trips over every example contract, the
# key-algebra guard, namespaces x kind tokens, advanced pub/sub, wildcard puts.
spike-s1: build
    {{spike}} s1 --results results/s1 --examples ../examples/zk2

# S9, the typed layer's cost (#592): control messages at 100 Hz-5 kHz and
# 4 MB frames at 30 Hz, typed against raw, QoS, SHM; plus micro-benchmarks.
spike-s9: build
    {{spike}} s9 --results results/s9 --repeat 3

# S10, wildcard bindings (#593): fan-in 1 -> 10 -> 100, churn (clean, kill -9,
# SIGSTOP as a cut), */tc, injection, and the graph from descriptors.
spike-s10: build
    {{spike}} s10 --results results/s10 --examples ../examples/zk2

# S11, control arbitration (#594): takeover, silence, crash, dead-man, safety,
# skew; P3 bindings against the P2 @in sink.
spike-s11: build
    {{spike}} s11 --results results/s11 --examples ../examples/zk2

# S13, simulation and replay (#596): rebinding by configuration, zenctl
# record/replay into a `replay` prefix, and a clock.v1 sketch at 1x, 0x, 2x.
# ZENCTL names a v1 zenctl (default: the one on PATH).
spike-s13: build
    {{spike}} s13 --results results/s13 --examples ../examples/zk2

# S4, contract retrieval by hash (#600): one and 200 holders; slow, corrupt
# and unreachable nearest holders; three routers; a constrained holder.
spike-s4: build
    {{spike}} s4 --results results/s4 --examples ../examples/zk2

# S6, operations and ownership (#602): split-brain, replicas, templated and
# fan-in queryables, fan-out refusal, many replies, partition, standby, metadata.
spike-s6: build
    {{spike}} s6 --results results/s6

# Reclaim the build tree (it is large, and the disk is shared).
clean:
    cargo clean
