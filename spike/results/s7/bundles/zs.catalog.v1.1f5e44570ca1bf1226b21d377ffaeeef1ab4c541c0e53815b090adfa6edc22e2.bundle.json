ch follow r3.2 §3.11 (payloads carry identities as structured fields, never as key strings). Each such field says what it was in v1. Those renames ARE the migration debt the README lists.","$defs":{"AckRequest":{"description":"Was ?ref=<origin>.<producer>.<alert_key>;note=. The server looks up the firing alarm and records its timestamp as fired_at.","properties":{"alert_ref":{"$ref":"#/$defs/AlertRef"},"note":{"type":"string"}},"required":["alert_ref"],"type":"object"},"AlertAck":{"description":"An acknowledgement applies only while a firing alarm with timestamp <= fired_at exists (ack.rs:12-30): an orphan is inert, and a re-fire is not acknowledged.","properties":{"alert_ref":{"$ref":"#/$defs/AlertRef"},"at":{"type":"integer"},"by":{"description":"The O7 call-metadata actor (v1: the ?actor= selector parameter). Claimed, not authenticated.","type":"string"},"fired_at":{"type":"integer"},"note":{"type":"string"}},"required":["alert_ref","fired_at","by","at"],"type":"object"},"AlertRef":{"description":"One alarm, by its bus coordinates. v1 packed these into one key chunk \"<origin>.<producer>.<alert_key>\" split on the first two dots (alert.rs:317-409), which breaks on a dotted service such as snmp.router01 (Gap G4). The interface is always alarms.v1.","properties":{"alert_key":{"type":"string"},"service":{"type":"string"},"system":{"type":"string"}},"required":["system","service","alert_key"],"type":"object"},"AlertSite":{"description":"v1 AlertSite {entity_id, origin, alert_key} (impact.rs:77-81) has no producer, so it could not name the alarm. zk2 adds the service.","properties":{"alert_key":{"type":"string"},"entity_id":{"type":"string"},"service":{"type":"string"},"system":{"type":"string"}},"required":["entity_id","system","service","alert_key"],"type":"object"},"AliasRecord":{"properties":{"entity_id":{"type":"string"},"last_updated":{"type":"integer"},"old_id":{"type":"string"}},"required":["old_id","entity_id","last_updated"],"type":"object"},"AssertionKind":{"enum":["link","unlink"],"type":"string"},"CatalogError":{"description":"The app error detail (O3). v1 registered error/catalog/not-firing and error/catalog/publish; v1's `serialize` becomes the core `internal`, and the closed gate the core `unavailable` with cause config.","properties":{"code":{"enum":["not_firing","publish"],"type":"string"},"message":{"type":"string"}},"required":["code"],"type":"object"},"Cause":{"description":"serde externally tagged, snake_case.","oneOf":[{"additionalProperties":false,"properties":{"entity":{"properties":{"entity_id":{"type":"string"}},"required":["entity_id"],"type":"object"}},"required":["entity"],"type":"object"},{"additionalProperties":false,"properties":{"alert":{"$ref":"#/$defs/AlertSite"}},"required":["alert"],"type":"object"}]},"Edge":{"description":"The catalog's conclusion: one relationship, both ends resolved. edge_id = \"e-\" ++ hex(fnv1a_64(kind 0x1f repr(from) 0x1f repr(to))), repr(Entity) = \"e:\" entity_id, repr(External) = \"x:\" ip \"|\" mac \"|\" name (RFC 11 §3.3; test vector e-2879d4667f9d946d).","properties":{"attrs":{"additionalProperties":{"type":"string"},"type":"object"},"edge_id":{"type":"string"},"from":{"$ref":"#/$defs/Endpoint"},"kind":{"$ref":"#/$defs/RelationKind"},"last_updated":{"type":"integer"},"observers":{"items":{"$ref":"#/$defs/Observer"},"type":"array"},"to":{"$ref":"#/$defs/Endpoint"}},"required":["edge_id","kind","from","to","last_updated"],"type":"object"},"Endpoint":{"description":"serde externally tagged, snake_case.","oneOf":[{"additionalProperties":false,"properties":{"entity":{"properties":{"entity_id":{"type":"string"}},"required":["entity_id"],"type":"object"}},"required":["entity"],"type":"object"},{"additionalProperties":false,"properties":{"external":{"properties":{"ip":{"type":"string"},"mac":{"type":"string"},"name":{"type":"string"}},"type":"object"}},"required":["external"],"type":"object"}]},"HostEntity":{"properties":{"aliases":{"items":{"type":"string"},"type":"array"},"boot_id":{"type":"string"},"container_ids":{"items":{"type":"string"},"type":"array"},"entity_id":{"description":"h-<12hex>; equal to the host's hostid.v1 system name when a member reported a machine id.","type":"string"},"fqdn":{"type":"string"},"host_id":{"type":"string"},"hostname":{"type":"string"},"ips":{"items":{"type":"string"},"type":"array"},"last_updated":{"type":"integer"},"macs":{"items":{"type":"string"},"type":"array"},"members":{"items":{"$ref":"#/$defs/MemberClaim"},"type":"array"},"names":{"items":{"$ref":"#/$defs/NameVal"},"type":"array"},"platform":{"type":"string"},"status":{"enum":["online","degraded","offline","unknown"],"type":"string"},"systems":{"description":"The systems whose self-reports resolved to this entity: the system -> entity join (RFC 06 §5.1). v1 `origins` (entity.rs:207).","items":{"type":"string"},"type":"array"},"vendor":{"type":"string"}},"required":["entity_id","last_updated"],"type":"object"},"IdRequest":{"description":"Was ?id=<ulid>.","properties":{"id":{"type":"string"}},"required":["id"],"type":"object"},"Incident":{"properties":{"acked":{"minimum":0,"type":"integer"},"alerts":{"items":{"$ref":"#/$defs/AlertRef"},"type":"array"},"entity_id":{"type":"string"},"id":{"description":"inc-<entity_id>, or inc-<system> when the system resolves to no entity. Also the key's {incident_id}.","type":"string"},"impacted":{"items":{"type":"string"},"type":"array"},"last_change":{"type":"integer"},"last_updated":{"type":"integer"},"severity":{"$ref":"#/$defs/Severity"},"silenced":{"minimum":0,"type":"integer"},"started":{"type":"integer"},"summary":{"type":"string"},"symptom_of":{"$ref":"#/$defs/Cause"},"systems":{"description":"Every system contributing a firing alarm. v1 `origins` (incident.rs:50).","items":{"type":"string"},"type":"array"}},"required":["id","systems","severity","started","last_change","summary","alerts","acked","silenced","last_updated"],"type":"object"},"LinkRequest":{"description":"Was ?old=<origin>;new=<origin>.","properties":{"new":{"type":"string"},"note":{"type":"string"},"old":{"type":"string"}},"required":["old","new"],"type":"object"},"MatchOp":{"enum":["eq","regex"],"type":"string"},"Matcher":{"properties":{"name":{"description":"system | service | rule | labels.<name>. v1 matched origin | producer | source (silence.rs:117); `source` disappears with device-as-service, because the device is the service.","type":"string"},"op":{"$ref":"#/$defs/MatchOp"},"value":{"type":"string"}},"required":["name","value"],"type":"object"},"MemberClaim":{"description":"One evidence claim merged into an entity. v1: (sensor, source); zk2 names the evidence publisher by (system, service).","properties":{"confidence":{"type":"number"},"last_seen":{"type":"integer"},"rule":{"enum":["host_id","mac_ip","fqdn","hostname"],"type":"string"},"service":{"description":"v1 `sensor` (the producer).","type":"string"},"source":{"type":"string"},"system":{"type":"string"}},"required":["system","service","source","rule","confidence","last_seen"],"type":"object"},"NameVal":{"properties":{"last_seen":{"type":"integer"},"name":{"type":"string"},"provenance":{"type":"string"}},"required":["name","provenance","last_seen"],"type":"object"},"NamesRequest":{"description":"Was ?ip=.","properties":{"ip":{"type":"string"}},"required":["ip"],"type":"object"},"Observer":{"description":"Who still claims an edge. v1: {sensor, origin} (relation.rs:306-311).","properties":{"service":{"type":"string"},"system":{"type":"string"}},"required":["system","service"],"type":"object"},"OperatorAssertion":{"properties":{"asserted_at":{"type":"integer"},"by":{"description":"zk2 addition: the O7 call-metadata actor of the link/unlink call. v1 recorded no author for assertions.","type":"string"},"id":{"description":"\"<kind>-<old>-<new>\" (entity.rs:117): two system names packed into one key chunk. Kept because it is stable and re-derivable, but see migration debt.","type":"string"},"kind":{"$ref":"#/$defs/AssertionKind"},"new":{"type":"string"},"note":{"type":"string"},"old":{"description":"A system name (v1: an origin).","type":"string"}},"required":["id","kind","old","new","asserted_at"],"type":"object"},"PdnsRecord":{"properties":{"ip":{"description":"The real address; the key carries its slug.","type":"string"},"last_updated":{"type":"integer"},"names":{"items":{"$ref":"#/$defs/NameVal"},"type":"array"}},"required":["ip","last_updated"],"type":"object"},"RelationKind":{"enum":["hosts","runs","gateway_of","probes","l2_adjacent"],"type":"string"},"Severity":{"enum":["info","warning","critical"],"type":"string"},"Silence":{"properties":{"by":{"description":"The O7 call-metadata actor.","type":"string"},"ends_at":{"type":"integer"},"id":{"description":"ULID; the key's {id}.","type":"string"},"matchers":{"description":"All must match; an empty set matches nothing.","items":{"$ref":"#/$defs/Matcher"},"type":"array"},"note":{"type":"string"},"starts_at":{"type":"integer"}},"required":["id","matchers","starts_at","ends_at","by"],"type":"object"},"SilenceRequest":{"description":"Silence without `by`, which comes from the call metadata.","properties":{"ends_at":{"type":"integer"},"id":{"type":"string"},"matchers":{"items":{"$ref":"#/$defs/Matcher"},"type":"array"},"note":{"type":"string"},"starts_at":{"type":"integer"}},"required":["id","matchers","starts_at","ends_at"],"type":"object"}},"$id":"zs.catalog.v1.json","$schema":"https://json-schema.org/draft/2020-12/schema"},"kind":"jsonschema"}}}