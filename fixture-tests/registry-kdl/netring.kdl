// Generated from ../registry/ by fixture-tests/tests/formats.rs — the KDL
// mirror of the corpus (RFC 08 §5.1). Regenerate, never edit:
//   REGENERATE_KDL_MIRROR=1 cargo test -p zenkey-fixture-tests --test formats

registry version="1.1" app="zensight" convention=1

producer "netring" description="wire-level flow/L7/NDR sensor"

budget rss_mb=64 {
    table "flows" max_entries=65536 max_bytes=16777216
    table "names" max_entries=16384
}

subject "flow/started_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="flows started"

subject "flow/ended_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="flows ended"

subject "flow/active" class=telemetry type="TelemetryPoint" kind=gauge \
    since="1.1" description="flows currently active"

subject "flow/bytes_total" class=telemetry type="TelemetryPoint" kind=counter \
    since="1.1" description="bytes across flows"

subject "flow/packets_total" class=telemetry type="TelemetryPoint" kind=counter \
    since="1.1" description="packets across flows"

subject "flow/retransmits_total" class=telemetry type="TelemetryPoint" \
    since="1.1" description="retransmits across flows"

subject "flow/by_l4/{proto}/bytes_total" class=telemetry type="TelemetryPoint" \
    cardinality=8 since="1.1" description="bytes by L4 protocol"

subject "flow/by_l4/{proto}/flows_total" class=telemetry type="TelemetryPoint" \
    cardinality=8 since="1.1" description="flows by L4 protocol"

subject "tcp/closed_fin_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="flows closed by FIN"

subject "tcp/closed_rst_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="flows closed by RST"

subject "tcp/closed_idle_total" class=telemetry type="TelemetryPoint" \
    since="1.1" description="flows closed by idle timeout"

subject "tcp/resets_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="RSTs observed"

subject "tcp/refused_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="connection refusals"

subject "capture/{source}/packets" class=telemetry type="TelemetryPoint" \
    cardinality=32 since="1.1" description="packets captured"

subject "capture/{source}/drops" class=telemetry type="TelemetryPoint" \
    cardinality=32 since="1.1" description="capture drops"

subject "capture/{source}/drop_rate" class=telemetry type="TelemetryPoint" \
    cardinality=32 since="1.1" description="drop rate"

subject "capture/{source}/freezes" class=telemetry type="TelemetryPoint" \
    cardinality=32 since="1.1" description="AF_PACKET ring freezes"

subject "capture/{source}/xdp/rx_dropped" class=telemetry type="TelemetryPoint" \
    cardinality=64 since="1.1" description="AF_XDP rx dropped"

subject "capture/{source}/xdp/rx_invalid_descs" class=telemetry \
    type="TelemetryPoint" cardinality=64 since="1.1" \
    description="invalid rx descriptors"

subject "capture/{source}/xdp/rx_ring_full" class=telemetry \
    type="TelemetryPoint" cardinality=64 since="1.1" description="rx ring full"

subject "capture/{source}/xdp/rx_fill_ring_empty_descs" class=telemetry \
    type="TelemetryPoint" cardinality=64 since="1.1" \
    description="fill ring empty"

subject "capture/{source}/xdp/tx_invalid_descs" class=telemetry \
    type="TelemetryPoint" cardinality=64 since="1.1" \
    description="invalid tx descriptors"

subject "capture/{source}/xdp/tx_ring_empty_descs" class=telemetry \
    type="TelemetryPoint" cardinality=64 since="1.1" description="tx ring empty"

subject "capture/{source}/shed/new_flows_total" class=telemetry \
    type="TelemetryPoint" cardinality=32 since="1.1" \
    description="flows shed under load"

subject "capture/{source}/shed/sampled_total" class=telemetry \
    type="TelemetryPoint" cardinality=32 since="1.1" \
    description="flows sampled under load"

subject "capture/{source}/shed/active" class=telemetry type="TelemetryPoint" \
    cardinality=32 since="1.1" description="load shedding engaged"

subject "capture/focus/packets" class=telemetry type="TelemetryPoint" \
    since="1.1" description="packets matching the focus filter"

subject "capture/focus/bytes" class=telemetry type="TelemetryPoint" since="1.1" \
    description="bytes matching the focus filter"

subject "capture/disk/mode" class=telemetry type="TelemetryPoint" since="1.1" \
    description="capture-to-disk mode (text)"

subject "capture/disk/ring_packets" class=telemetry type="TelemetryPoint" \
    since="1.1" description="packets in the disk ring"

subject "capture/disk/ring_bytes" class=telemetry type="TelemetryPoint" \
    since="1.1" description="bytes in the disk ring"

subject "capture/disk/retained_files" class=telemetry type="TelemetryPoint" \
    since="1.1" description="retained capture files"

subject "capture/disk/retained_bytes" class=telemetry type="TelemetryPoint" \
    since="1.1" description="retained bytes on disk"

subject "capture/disk/dropped" class=telemetry type="TelemetryPoint" since="1.1" \
    description="packets dropped by the disk writer"

subject "capture/disk/evictions" class=telemetry type="TelemetryPoint" \
    since="1.1" description="files evicted by retention"

subject "capture/disk/triggers" class=telemetry type="TelemetryPoint" \
    since="1.1" description="capture triggers fired"

subject "capture/events" class=telemetry type="TelemetryPoint" since="1.1" \
    description="capture-to-disk lifecycle events (text value, `event` label)"

subject "capture/backend" class=telemetry type="TelemetryPoint" since="1.1" \
    description="the capture backend in use (text; AF_PACKET | AF_XDP | pcap)"

subject "dns/queries_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="DNS queries"

subject "dns/unanswered_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="queries with no response"

subject "dns/query_rtt_p50_ms" class=telemetry type="TelemetryPoint" since="1.1" \
    description="query RTT p50"

subject "dns/query_rtt_p95_ms" class=telemetry type="TelemetryPoint" since="1.1" \
    description="query RTT p95"

subject "dns/query_rtt_p99_ms" class=telemetry type="TelemetryPoint" since="1.1" \
    description="query RTT p99"

subject "dns/responses_by_rcode/{rcode}" class=telemetry type="TelemetryPoint" \
    cardinality=32 since="1.1" \
    description="responses by rcode; the leaf is `<rcode>_total` (noerror|nxdomain|servfail|refused|...)"

subject "dns/encrypted/dot" class=telemetry type="TelemetryPoint" since="1.1" \
    description="DNS-over-TLS detections"

subject "dns/encrypted/doq" class=telemetry type="TelemetryPoint" since="1.1" \
    description="DNS-over-QUIC detections"

subject "dns/encrypted/doh" class=telemetry type="TelemetryPoint" since="1.1" \
    description="DNS-over-HTTPS detections"

subject "dns/encrypted/unknown_resolver" class=telemetry type="TelemetryPoint" \
    since="1.1" description="resolvers not on the allowlist"

subject "dns/encrypted/distinct" class=telemetry type="TelemetryPoint" \
    since="1.1" description="distinct encrypted-DNS resolvers"

subject "http/requests_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="HTTP requests"

subject "http/status_2xx_total" class=telemetry type="TelemetryPoint" \
    since="1.1" description="2xx responses"

subject "http/status_3xx_total" class=telemetry type="TelemetryPoint" \
    since="1.1" description="3xx responses"

subject "http/status_4xx_total" class=telemetry type="TelemetryPoint" \
    since="1.1" description="4xx responses"

subject "http/status_5xx_total" class=telemetry type="TelemetryPoint" \
    since="1.1" description="5xx responses"

subject "http/latency_p50_ms" class=telemetry type="TelemetryPoint" since="1.1" \
    description="request latency p50"

subject "http/latency_p95_ms" class=telemetry type="TelemetryPoint" since="1.1" \
    description="request latency p95"

subject "http/methods/{method}" class=telemetry type="TelemetryPoint" \
    cardinality=32 since="1.1" \
    description="requests by method; the leaf is `<method>_total`. The method comes off the wire (capped at 32 distinct)"

subject "icmp/unreachable_total" class=telemetry type="TelemetryPoint" \
    since="1.1" description="ICMP unreachable"

subject "icmp/time_exceeded_total" class=telemetry type="TelemetryPoint" \
    since="1.1" description="ICMP time exceeded"

subject "icmp/mtu_signal_total" class=telemetry type="TelemetryPoint" \
    since="1.1" description="ICMP fragmentation-needed (PMTUD)"

subject "icmp/by_kind/{kind}" class=telemetry type="TelemetryPoint" \
    cardinality=32 since="1.1" \
    description="ICMP errors by kind; the leaf is `<kind>_total`"

subject "tls/handshakes_total" class=telemetry type="TelemetryPoint" since="1.1" \
    description="TLS handshakes"

subject "tls/distinct_fingerprints" class=telemetry type="TelemetryPoint" \
    since="1.1" description="distinct JA4 fingerprints"

subject "tls/pq_ratio" class=telemetry type="TelemetryPoint" since="1.1" \
    description="share of handshakes offering post-quantum key exchange"

subject "quic/distinct_sni" class=telemetry type="TelemetryPoint" since="1.1" \
    description="distinct QUIC SNIs"

subject "ssh/distinct_hassh" class=telemetry type="TelemetryPoint" since="1.1" \
    description="distinct SSH HASSH fingerprints"

subject "assets/discovered" class=telemetry type="TelemetryPoint" since="1.1" \
    description="assets in the observed inventory"

subject "bandwidth/{app}/bytes_per_sec" class=telemetry type="TelemetryPoint" \
    cardinality=32 since="1.1" \
    description="wire-level throughput by application class (top 20)"

subject "anomaly/{kind}/total" class=telemetry type="TelemetryPoint" \
    cardinality=64 since="1.1" \
    description="detector firings by kind; {kind} is the detector slug from the netring crate + enabled feature detectors"

subject "flow/red/{quantile}" class=telemetry type="TelemetryPoint" unit="ms" \
    cardinality=5 since="1.0" \
    description="flow-lifetime RED quantiles from the capture path"

subject "evidence/names/{ip_slug}" common=evidence_names class=state \
    type="NameObservation" cardinality=4096 ttl_s=900 since="1.0" \
    description="passive-DNS observation for an actively observed IP (population-budgeted, RFC 04 §1.2)"

subject "health" common=health class=state type="HealthSnapshot" ttl_s=120 \
    since="1.0" \
    description="sensor health document (framework; absorbs the legacy @/status running flag)"

subject "errors" common=errors class=state type="ErrorReport" ttl_s=300 \
    since="1.0" description="rolling error window (framework)"

subject "sensor" common=sensor class=state type="SensorInfo" ttl_s=900 \
    since="1.0" \
    description="registration document: identity, version, capabilities (framework, 60 s re-emit)"

subject "evidence/device/{device}" common=evidence_device class=state \
    type="HostEvidence" cardinality=4096 ttl_s=900 since="1.0" \
    description="wire-observed asset identity claim (MAC/IP/vendor, RFC 06 §4)"

subject "evidence/self" common=evidence_self class=state type="HostEvidence" \
    ttl_s=900 since="1.0" description="self-identity claim (RFC 06 §4)"

subject "alert/{alert_key}" common=alert class=state type="Alert" qos=alert \
    cardinality=64 ttl_s=900 since="1.0" \
    description="alerts; firing->resolved on one key, delete = tombstone"

subject "artifact/{kind}" class=state type="ArtifactStatus" cardinality=16 \
    ttl_s=900 since="1.1" \
    description="per-kind artifact progress (framework: V1Context::artifact_status_key)"

procedure "introspect" kind=read reply="RegistrySlice" idempotent=#true \
    since="1.0" description="the registry slice this build serves (RFC 08 §6)"

procedure "artifact/request" kind=write request="ArtifactRequest" \
    reply="ArtifactAck" since="1.0" \
    description="initiate artifact generation; replies { id } immediately (RFC 05 §3)"

procedure "artifact/cancel" kind=write reply="Ack" since="1.0" \
    description="free an in-flight/ready artifact early (?id=<ulid>)"

procedure "artifact/status" kind=read reply="ArtifactStatus" idempotent=#true \
    since="1.0" \
    description="advertised artifact kinds + the in-flight/ready state per kind (RFC 05 §3)"

procedure "capture_disk" kind=read reply="CaptureDiskStatus" idempotent=#true \
    since="1.0" \
    description="capture-to-disk status (mode, ring occupancy, retention, last event)"

procedure "capture_disk/set" kind=write request="CaptureDiskCommand" reply="Ack" \
    since="1.0" \
    description="capture-to-disk control: capture_now / set_capture mode hot-switch"

procedure "detectors" kind=read reply="TopicStatus" idempotent=#true since="1.0" \
    description="current detectors configuration (runtime detection tuning)"

procedure "detectors/set" kind=write request="DetectorConfig" reply="Ack" \
    since="1.0" \
    description="apply detectors configuration (runtime detection tuning)"

procedure "capture_filter" kind=read reply="TopicStatus" idempotent=#true \
    since="1.0" \
    description="current capture_filter configuration (reloadable packet-tier BPF filter)"

procedure "capture_filter/set" kind=write request="FilterConfig" reply="Ack" \
    since="1.0" \
    description="apply capture_filter configuration (reloadable packet-tier BPF filter)"

procedure "threat_intel" kind=read reply="TopicStatus" idempotent=#true \
    since="1.0" \
    description="current threat_intel configuration (IOC/YARA hot-reload)"

procedure "threat_intel/set" kind=write request="ThreatIntelConfig" reply="Ack" \
    since="1.0" \
    description="apply threat_intel configuration (IOC/YARA hot-reload)"

procedure "flows" kind=read reply="Vec<FlowRecord>" idempotent=#true since="1.0" \
    description="flow ring (per-flow data never rides the bus, RFC 04 R3)"

procedure "tls" kind=read reply="Vec<TlsRecord>" idempotent=#true since="1.0" \
    description="TLS fingerprint ring"

procedure "talkers" kind=read reply="Vec<TalkerRecord>" idempotent=#true \
    since="1.0" description="per-source rolling rate (?top=N)"

procedure "matrix" kind=read reply="Vec<MatrixRecord>" idempotent=#true \
    since="1.0" description="src/dst rolling rate matrix (?top=N)"

procedure "elephant_flows" kind=read reply="Vec<FlowRecord>" idempotent=#true \
    since="1.0" description="elephant flow ring"

procedure "dns" kind=read reply="Vec<DnsRecord>" idempotent=#true since="1.0" \
    description="DNS ring (?top=N)"

procedure "http" kind=read reply="Vec<HttpRecord>" idempotent=#true since="1.0" \
    description="HTTP ring (?top=N)"

procedure "quic" kind=read reply="Vec<QuicRecord>" idempotent=#true since="1.0" \
    description="QUIC ring"

procedure "ssh" kind=read reply="Vec<SshRecord>" idempotent=#true since="1.0" \
    description="SSH/HASSH ring"

procedure "encrypted_dns" kind=read reply="Vec<EncryptedDnsRecord>" \
    idempotent=#true since="1.0" description="DoH/DoT detections"

procedure "ja4h" kind=read reply="Vec<Ja4hRecord>" idempotent=#true since="1.0" \
    description="JA4H fingerprints (feature ja4plus, ?top=N)"

procedure "assets" kind=read reply="Vec<AssetRecord>" idempotent=#true \
    since="1.0" description="observed asset inventory"

procedure "ipfix" kind=read reply="Vec<IpfixRecord>" idempotent=#true \
    since="1.0" \
    description="recent IPFIX/Netflow-style flow records (feature `ipfix`; ?max=)"

procedure "captures" kind=read reply="Vec<CaptureRecord>" idempotent=#true \
    since="1.0" description="capture-to-disk file index"

procedure "bandwidth" kind=read reply="Vec<BandwidthRecord>" idempotent=#true \
    since="1.0" description="wire-level bandwidth-by-process (?top=N)"

blob "artifact" reference="BlobReference" \
    encoding="application/vnd.tcpdump.pcap" since="1.8" \
    description="packet captures and debug bundles minted by @rpc/netring/artifact" {
    endpoints "manifest" "slice" "have" "push" "fanout"
}

blob "tree" reference="BlobReference" since="1.8" \
    description="capture-bundle directory snapshots, keyed by their own root hash"
