// Generated from ../registry/ by fixture-tests/tests/formats.rs — the KDL
// mirror of the corpus (RFC 08 §5.1). Regenerate, never edit:
//   REGENERATE_KDL_MIRROR=1 cargo test -p zenkey-fixture-tests --test formats

registry version="1.2" app="zensight" convention=1

service "catalog" origin="@catalog" \
    description="identity/ontology service (zensight-correlator); single writer via the RFC 06 §5.3 claim protocol"

subject "entity/{entity_id}" common=entity class=state type="HostEntity" \
    cardinality=10000 ttl_s=900 since="1.0" \
    description="merged entity document (LWW, tombstoned on retire/merge)"

subject "alias/{old_id}" common=alias class=state type="AliasRecord" \
    cardinality=1000 ttl_s=31536000 since="1.0" \
    description="old-id -> entity-id re-pointing on merges/upgrades; operator-retained (RFC 06 §5.4)"

subject "pdns/{ip_slug}" common=pdns class=state type="PdnsRecord" \
    cardinality=100000 ttl_s=86400 since="1.0" \
    description="accumulated IP<->name record; history = storage capture (RFC 06 §5.2; population-budgeted)"

subject "incident/{incident_id}" common=incident class=state type="Incident" \
    cardinality=10000 ttl_s=900 since="1.2" \
    description="the currently-firing alerts for one entity (inc-<entity-id>, or inc-<origin> when unresolved); tombstoned when no member fires (RFC 06 §5.5)"

subject "ack/{alert_ref}" common=ack class=state type="AlertAck" \
    cardinality=1000 ttl_s=0 since="1.2" \
    description="one operator's acknowledgement of one firing alert, keyed by the RFC 11 §3.2 alert-ref; operator intent never ages out, the catalog tombstones it (RFC 06 §5.5)"

subject "silence/{id}" common=silence class=state type="Silence" \
    cardinality=1000 ttl_s=0 since="1.2" \
    description="a suppression window with matchers, bounds and an author; holds across re-fires, tombstoned at ends_at (RFC 06 §5.5)"

subject "edge/{edge_id}" common=edge class=state type="Edge" cardinality=50000 \
    ttl_s=900 since="1.2" \
    description="a resolved relationship between two entities (or an External end), concluded from evidence/relation claims; tombstoned when the last observer stops claiming it (RFC 06 §5.6)"

subject "assertion/{id}" class=state type="OperatorAssertion" cardinality=1000 \
    ttl_s=0 since="1.1" \
    description="operator identity assertion (link/unlink, RFC 06 §5.4); operator evidence — strong, never ages out"

procedure "link" kind=write reply="OperatorAssertion" idempotent=#true \
    since="1.1" \
    description="assert two origins are one host (?old=...;new=...); gated (RFC 06 §5.4)"

procedure "unlink" kind=write reply="OperatorAssertion" idempotent=#true \
    since="1.1" \
    description="assert two origins are NOT one host, retiring any link (?old=...;new=...); gated"

procedure "names" kind=read reply="Vec<NameVal>" idempotent=#true since="1.0" \
    description="on-demand name resolution (?ip=...)"

procedure "introspect" kind=read reply="RegistrySlice" idempotent=#true \
    since="1.0" description="the registry slice this build serves (RFC 08 §6)"
