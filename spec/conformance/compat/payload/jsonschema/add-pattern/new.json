{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Status": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        },
        "since_ms": {
          "type": "integer",
          "minimum": 0
        },
        "load": {
          "type": "number",
          "maximum": 100
        },
        "label": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z]+$"
        },
        "note": {
          "type": "string",
          "description": "free text"
        }
      },
      "required": [
        "state"
      ]
    }
  },
  "$ref": "#/$defs/Status"
}