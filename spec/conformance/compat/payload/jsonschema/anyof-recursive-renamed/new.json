{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Status": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/Link"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "state"
      ]
    },
    "Link": {
      "type": "object",
      "properties": {
        "hop": {
          "type": "string"
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/$defs/Link"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "hop"
      ]
    }
  },
  "$ref": "#/$defs/Status"
}