{
  "description": "core §7.7, a frame's declaration. Written by an independent reading of the text (Python, standard library, over B1's independent reading of §7.6), checked, never blessed. `schema` is one packed document (core §7.6) every case shares. Each layout is a record type of it and a `frame` table as a contract writes it, the keys it omits taking §7.7's defaults → `form`, the frame form (`frame`: `records`, `step_ms` and `jitter_ms`, both null without a step, and `deadband`, one item per field in field order, null or `{delta, max_records}` with delta in its shortest form; `record`: the record type's layout form), `sha256`, the lowercase hex sha256 of the form's JCS bytes, `tag`, the low four bits of that hash's last byte, `count_bits`, ⌈log₂ records⌉, `offset_bits`, ⌈log₂ span⌉ or null without a step, and `span_ms`, records × step_ms or null. `keyframe_every` reaches none of them.",
  "schema": {
    "description": "core §7.7's frames: zenoh-modem's four link readings, a sampler's record, and a one-field tick",
    "types": {
      "Link": {
        "description": "modem.v3's link readings: sdu/dropped_total, sched/queue_depth, air/duty_cycle_available, air/duty_cycle_wait_ms",
        "fields": [
          {
            "name": "dropped",
            "type": "counter",
            "width": 32,
            "optional": true
          },
          {
            "name": "queue_depth",
            "type": "int",
            "minimum": 0,
            "maximum": 1022,
            "reserved": [
              "out_of_range"
            ],
            "optional": true
          },
          {
            "name": "duty_available",
            "type": "int",
            "minimum": 0,
            "maximum": 1,
            "optional": true
          },
          {
            "name": "duty_wait_ms",
            "type": "fixed",
            "minimum": "0",
            "maximum": "3600000",
            "resolution": "100",
            "reserved": [
              "out_of_range"
            ],
            "optional": true
          }
        ]
      },
      "Sample": {
        "fields": [
          {
            "name": "temperature",
            "type": "fixed",
            "minimum": "-40",
            "maximum": "85",
            "resolution": "0.5"
          },
          {
            "name": "rssi",
            "type": "int",
            "minimum": -140,
            "maximum": -20,
            "reserved": [
              "not_available"
            ]
          },
          {
            "name": "link_up",
            "type": "bool"
          },
          {
            "name": "mode",
            "type": "enum",
            "values": [
              "idle",
              "rx",
              "tx"
            ],
            "escape": true,
            "optional": true
          }
        ]
      },
      "Tick": {
        "fields": [
          {
            "name": "n",
            "type": "counter",
            "width": 8
          }
        ]
      }
    }
  },
