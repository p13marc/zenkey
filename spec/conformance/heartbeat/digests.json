        {
          "key": "zk2/lab/n1/hb.v1/state/peer/charlie",
          "run_width": 16,
          "run": 3,
          "seq": 12
        },
        {
          "key": "zk2/lab/n1/hb.v1/state/peer/alpha",
          "run_width": 16,
          "run": 3,
          "seq": 10
