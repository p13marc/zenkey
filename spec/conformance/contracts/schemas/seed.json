{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "Status": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        },
        "since_ms": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "Empty": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Ack": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Rename": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "properties": {
        "partial": {
          "type": "boolean"
        },
        "scanned": {
          "type": "integer"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}
