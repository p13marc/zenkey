{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Point": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "Track": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "seed.json#/$defs/Point"
        }
      },
      "additionalProperties": false
    }
  }
}
