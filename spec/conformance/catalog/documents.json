      "expect": {
        "refused": "lineage"
      }
    },
    {
      "note": "two lineage items with one id",
      "text": "{\"format\": \"zk2-catalog/1\", \"epoch\": 0, \"entries\": [{\"index\": 0, \"iface\": \"modem.v3\", \"contract\": \"sha256:9a3e2859a538a95daafc53e7dffe8c9d0610312f7650f27250b9e6fee0965953\"}], \"lineage\": [{\"id\": \"0000abcd\", \"entries\": 0}, {\"id\": \"0000abcd\", \"entries\": 1}]}",
      "expect": {
        "refused": "lineage"
      }
    },
