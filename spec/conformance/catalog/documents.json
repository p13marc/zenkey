      "note": "a lineage count above the catalog's",
      "text": "{\"format\": \"zk2-catalog/1\", \"epoch\": 0, \"entries\": [{\"index\": 0, \"iface\": \"modem.v3\", \"contract\": \"sha256:9a3e2859a538a95daafc53e7dffe8c9d0610312f7650f27250b9e6fee0965953\"}], \"lineage\": [{\"id\": \"0000abcd\", \"entries\": 2}]}",
      "expect": {
        "refused": "lineage"
      }
    },
    {
      "note": "lineage counts that go down",
      "text": "{\"format\": \"zk2-catalog/1\", \"epoch\": 0, \"entries\": [{\"index\": 0, \"iface\": \"modem.v3\", \"contract\": \"sha256:9a3e2859a538a95daafc53e7dffe8c9d0610312f7650f27250b9e6fee0965953\"}, {\"index\": 1, \"iface\": \"config.v1\", \"contract\": \"sha256:727ff0090b99ad8fc09b5398804d1a14288bebf661f374ec6904351344a1a7b1\"}], \"lineage\": [{\"id\": \"0000abcd\", \"entries\": 2}, {\"id\": \"0000abce\", \"entries\": 1}]}",
      "expect": {
        "refused": "lineage"
      }
    },
    {
