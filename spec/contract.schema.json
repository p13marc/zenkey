{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractFile",
  "description": "One contract file: one interface major.",
  "type": "object",
  "properties": {
    "defaults": {
      "anyOf": [
        {
          "$ref": "#/$defs/DefaultsSection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "interface": {
      "$ref": "#/$defs/InterfaceSection"
    },
    "requires": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Requirement"
      },
      "default": {}
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ResourceSpec"
      },
      "default": {}
    },
    "schemas": {
      "$ref": "#/$defs/SchemasSection",
      "default": {
        "jsonschema": [],
        "packed": [],
        "proto_include": null,
        "protobuf": []
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "interface"
  ],
  "$defs": {
    "Cardinality": {
      "description": "A templated resource's `cardinality`: a number, the most members one instance will hold, or `\"unbounded\"`, which is 4294967295 (core §2.2).",
      "anyOf": [
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "type": "string",
          "enum": [
            "unbounded"
          ]
        }
      ]
    },
    "Congestion": {
      "type": "string",
      "enum": [
        "drop",
        "block"
      ]
    },
    "DeadbandSpec": {
      "description": "A deadband (core §7.7): the field omitted while within `delta` of the\nvalue last included, and included at least every `max_records`.",
      "type": "object",
      "properties": {
        "delta": {
          "description": "A decimal string above 0, in the field's units (§7.6's grammar).",
          "type": "string"
        },
        "max_records": {
          "description": "1 to 65,536.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "delta",
        "max_records"
      ]
    },
    "DefaultsBlock": {
      "description": "The fields `[defaults]` may set (r3.3 D2).",
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "attachment_encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Encoding"
            },
            {
              "type": "null"
            }
          ]
        },
        "congestion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Congestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Encoding"
            },
            {
              "type": "null"
            }
          ]
        },
        "express": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fanout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fanout"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "anyOf": [
            {
              "$ref": "#/$defs/History"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ]
        },
        "reliability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reliability"
            },
            {
              "type": "null"
            }
          ]
        },
        "replies": {
          "anyOf": [
            {
              "$ref": "#/$defs/Replies"
            },
            {
              "type": "null"
            }
          ]
        },
        "serving": {
          "anyOf": [
            {
              "$ref": "#/$defs/Serving"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "DefaultsSection": {
      "description": "`[defaults]` and `[defaults.<kind>]`.",
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "attachment_encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Encoding"
            },
            {
              "type": "null"
            }
          ]
        },
        "congestion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Congestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Encoding"
            },
            {
              "type": "null"
            }
          ]
        },
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefaultsBlock"
            },
            {
              "type": "null"
            }
          ]
        },
        "express": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fanout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fanout"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "anyOf": [
            {
              "$ref": "#/$defs/History"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefaultsBlock"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ]
        },
        "reliability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reliability"
            },
            {
              "type": "null"
            }
          ]
        },
        "replies": {
          "anyOf": [
            {
              "$ref": "#/$defs/Replies"
            },
            {
              "type": "null"
            }
          ]
        },
        "serving": {
          "anyOf": [
            {
              "$ref": "#/$defs/Serving"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefaultsBlock"
            },
            {
              "type": "null"
            }
          ]
        },
        "stream": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefaultsBlock"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Deprecated": {
      "type": "object",
      "properties": {
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "replaced_by": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "since": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "since"
      ]
    },
    "Encoding": {
      "type": "string",
      "enum": [
        "json",
        "cbor"
      ]
    },
    "Fanout": {
      "type": "string",
      "enum": [
        "forbidden",
        "allowed"
      ]
    },
    "FrameSpec": {
      "description": "`frame = { records, step_ms, jitter_ms, keyframe_every, deadband }`\n(core §7.7, draft 4), as written: its bounds are E048's, never the\nschema's, so a value out of range is a lint and not a load failure.",
      "type": "object",
      "properties": {
        "deadband": {
          "description": "A field's name → its deadband.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DeadbandSpec"
          },
          "default": {}
        },
        "jitter_ms": {
          "description": "How far a scheduled record may lie from its instant: 0 to\n`step_ms` / 2, only with `step_ms`; 0 when absent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "keyframe_every": {
          "description": "A full record at least once every this many records, 1 to 65,536;\n1 when absent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "records": {
          "description": "The most records one frame holds, 1 to 256; 1 when absent.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "step_ms": {
          "description": "Record i is scheduled `step_ms` × i after record 0: 1 to 2^32 − 1,\ngiven exactly when `records` is above 1.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Gate": {
      "description": "`gate = \"capability:rssi\"` or a list of them (AND).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "History": {
      "description": "`history = true` or `{ depth = <n>, miss_detection_ms = <ms> }`.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/HistoryParams"
        }
      ]
    },
    "HistoryParams": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "miss_detection_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "depth"
      ]
    },
    "InterfaceSection": {
      "description": "`[interface]`.",
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "minor": {
          "description": "Informative; CI keeps it monotonic; not in the fingerprint.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "maximum": 4294967295,
          "minimum": 0
        },
        "name": {
          "description": "`[a-z][a-z0-9_]*` segments joined by `.`; never ending in `.v<int>`.",
          "type": "string"
        },
        "summary": {
          "description": "Documentation; not in the fingerprint.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "uses": {
          "description": "Profiles whose annotations the contract uses (`freshness.v1`, …).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "major"
      ]
    },
    "Kind": {
      "type": "string",
      "enum": [
        "stream",
        "state",
        "event",
        "operation"
      ]
    },
    "ParamType": {
      "type": "string",
      "enum": [
        "string",
        "uint",
        "path"
      ]
    },
    "Priority": {
      "description": "Zenoh's seven priorities, by name.",
      "type": "string",
      "enum": [
        "real_time",
        "interactive_high",
        "interactive_low",
        "data_high",
        "data",
        "data_low",
        "background"
      ]
    },
    "RawType": {
      "type": "object",
      "properties": {
        "media_param": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "raw": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "raw"
      ]
    },
    "Reliability": {
      "type": "string",
      "enum": [
        "best_effort",
        "reliable"
      ]
    },
    "Replies": {
      "type": "string",
      "enum": [
        "one",
        "many"
      ]
    },
    "RequireCardinality": {
      "type": "string",
      "enum": [
        "one",
        "many"
      ]
    },
    "Requirement": {
      "description": "`[requires.<role>]`.",
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "cardinality": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequireCardinality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "interface": {
          "description": "The required interface, `<name>.v<major>`.",
          "type": "string"
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "resources": {
          "description": "What is consumed; default: everything.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "interface"
      ]
    },
    "ResourceSpec": {
      "description": "`[resources.\"<template>\"]`: every field any kind may carry. Which ones\na kind accepts is checked by the lints (E014).",
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "attachment": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attachment_encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Encoding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cardinality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cardinality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "congestion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Congestion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deprecated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Deprecated"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "doc": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Encoding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "epoch": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explicit": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "express": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "fanout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fanout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frame": {
          "description": "A frame resource's `frame` table (core §7.7, draft 4): a plain\nstream's alone, never defaulted.",
          "anyOf": [
            {
              "$ref": "#/$defs/FrameSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "history": {
          "anyOf": [
            {
              "$ref": "#/$defs/History"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "idempotent": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ParamType"
          },
          "default": {}
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rate": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "reliability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reliability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replies": {
          "anyOf": [
            {
              "$ref": "#/$defs/Replies"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retention": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "serving": {
          "anyOf": [
            {
              "$ref": "#/$defs/Serving"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "SchemasSection": {
      "description": "`[schemas]`.",
      "type": "object",
      "properties": {
        "jsonschema": {
          "description": "JSON Schema 2020-12 files (the zk2 subset), definitions under `$defs`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "packed": {
          "description": "Packed files (core §7.6, draft 3): strict JSON, types under `types`,\nreferenced as `packed:<Name>` or `packed:<stem>#<Name>`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "proto_include": {
          "description": "Include roots for protobuf imports, relative to the contract's\ndirectory. Default: `[\"proto\"]` when that directory exists, else `[\".\"]`.",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "type": "string"
          }
        },
        "protobuf": {
          "description": "`.proto` files, relative to the contract's directory. proto2/proto3.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Serving": {
      "type": "string",
      "enum": [
        "exclusive",
        "replicated"
      ]
    },
    "TypeRef": {
      "description": "A type reference: `\"pkg.Message\"`, `\"json:Name\"`, `\"json:stem#Name\"`,\n`\"packed:Name\"`, `\"packed:stem#Name\"`, or\n`{ raw = \"<media type>\", media_param = \"<param>\" }`.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/RawType"
        }
      ]
    }
  }
}
