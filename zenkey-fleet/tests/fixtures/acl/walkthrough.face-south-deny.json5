  rules: [
    // own (vehicle-01/thruster-l): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:vehicle-01/thruster-l", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/vehicle-01/thruster-l/**", "zk2/vehicle-01/thruster-l/*/@stream/**", "zk2/vehicle-01/thruster-l/*/@state/**", "zk2/vehicle-01/thruster-l/*/@op/**", "zk2/vehicle-01/thruster-l/@zk/**"] },
