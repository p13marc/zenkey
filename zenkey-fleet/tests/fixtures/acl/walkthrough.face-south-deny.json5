    // face_declarations (ground): §8.5, U23: a far router in a south region learns of this router's queryables by declaration, on interest, and routes a query here only for one it has learnt; the queryables over what the far side may GET or call are declared toward it (measured, #612 FJ7: without this rule its GET gets no reply). A client principal needs none: it sends every query to its router
    { id: "face-declarations:ground", permission: "allow", flows: ["egress"],
      messages: ["declare_queryable"],
      key_exprs: ["zk2/ground/fleet-mgr/mission_plan.v1/state/plans/*", "zk2/ground/fleet-mgr/mission_plan.v1/state/**", "zk2/vehicle-01/navigation/nav.v2/state/**", "zk2/vehicle-01/navigation/nav.v2/stream/**", "zk2/vehicle-01/*/thruster.v1/state/status", "zk2/vehicle-01/thruster-l/thruster.v1/@op/arm", "zk2/vehicle-01/thruster-l/thruster.v1/@op/disarm", "zk2/vehicle-01/thruster-r/thruster.v1/@op/arm", "zk2/vehicle-01/thruster-r/thruster.v1/@op/disarm", "zk2/vehicle-01/navigation/nav.v2/@op/set_origin", "zk2/vehicle-01/*/thruster.v1/state/**"] },
    // face_presence (ground): link.v1 §2.6, §8.5: no `@zk` traffic across a constrained face, never omitted. Bindings resolve statically (R7), bundles are held on each side, and presence never crosses; `**` matches zero chunks, so the contract keys are included
    { id: "face:ground:zk", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/**/@zk/**"] },
    // face_adv (ground): link.v1 §2.6: across a face an exposed resource is read live, never with history: advanced publication's tokens are presence of publishers, and its replay is bounded by no face's rate
    { id: "face:ground:adv", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/**/@adv/**"] },
    // face_admin (ground): link.v1 §2.6: the routers' admin space, never namespaced; a check that needs it runs on the near side, and across the face it is unobservable
    { id: "face:ground:admin", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["@/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:ground:stream", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/stream/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:ground:@stream", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/@stream/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:ground:state", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/state/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:ground:@state", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/@state/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:ground:events", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/events/**"] },
  ],
  subjects: [
    // link.v1 §2.4 (0.3, F-118): zenoh ties no credential to a link, so a subject bound by a user name or a CN alone matches that principal's session over a face too; each principal's subject is selected by the link protocols outside the faces whose far principal it is not; under deny, a session matching no subject is granted nothing.
    { id: "thruster-l", usernames: ["thruster-l"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/thruster-l
    { id: "thruster-r", usernames: ["thruster-r"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/thruster-r
    { id: "teleop", usernames: ["teleop"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/teleop
    { id: "autopilot", usernames: ["autopilot"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/autopilot
    { id: "safety", usernames: ["safety"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/safety
    { id: "navigation", usernames: ["navigation"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/navigation
    { id: "cam-front", usernames: ["cam-front"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/cam-front
    { id: "detector", usernames: ["detector"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/detector
    { id: "tracker", usernames: ["tracker"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/tracker
    { id: "zenwatch", usernames: ["zenwatch"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/zenwatch, tool.zenwatch
    { id: "executor", usernames: ["executor"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/executor
    { id: "archive", usernames: ["archive"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs vehicle-01/archive
    { id: "ground", usernames: ["ground"] },  // runs ground/fleet-mgr, ground/archive, tool.ops
  ],
  policies: [
    { id: "thruster-l", rules: ["own-in:vehicle-01/thruster-l", "own-out:vehicle-01/thruster-l", "fan-in-presence:vehicle-01/thruster-l", "fan-in:vehicle-01/thruster-l", "fan-in-reply:vehicle-01/thruster-l", "consume-in:vehicle-01/thruster-l", "consume-out:vehicle-01/thruster-l", "presence-in:vehicle-01/thruster-l", "presence-out:vehicle-01/thruster-l", "contracts-in", "contracts-out"],
      subjects: ["thruster-l"] },
    { id: "thruster-r", rules: ["own-in:vehicle-01/thruster-r", "own-out:vehicle-01/thruster-r", "fan-in-presence:vehicle-01/thruster-r", "fan-in:vehicle-01/thruster-r", "fan-in-reply:vehicle-01/thruster-r", "consume-in:vehicle-01/thruster-r", "consume-out:vehicle-01/thruster-r", "presence-in:vehicle-01/thruster-r", "presence-out:vehicle-01/thruster-r", "contracts-in", "contracts-out"],
      subjects: ["thruster-r"] },
    { id: "teleop", rules: ["own-in:vehicle-01/teleop", "own-out:vehicle-01/teleop", "fan-in-presence:vehicle-01/teleop", "contracts-in", "contracts-out"],
      subjects: ["teleop"] },
    { id: "autopilot", rules: ["own-in:vehicle-01/autopilot", "own-out:vehicle-01/autopilot", "fan-in-presence:vehicle-01/autopilot", "contracts-in", "contracts-out"],
      subjects: ["autopilot"] },
    { id: "safety", rules: ["own-in:vehicle-01/safety", "own-out:vehicle-01/safety", "fan-in-presence:vehicle-01/safety", "contracts-in", "contracts-out"],
      subjects: ["safety"] },
    { id: "navigation", rules: ["own-in:vehicle-01/navigation", "own-out:vehicle-01/navigation", "fan-in-presence:vehicle-01/navigation", "fan-in:vehicle-01/navigation", "fan-in-reply:vehicle-01/navigation", "contracts-in", "contracts-out"],
      subjects: ["navigation"] },
    { id: "cam-front", rules: ["own-in:vehicle-01/cam-front", "own-out:vehicle-01/cam-front", "fan-in-presence:vehicle-01/cam-front", "contracts-in", "contracts-out"],
      subjects: ["cam-front"] },
    { id: "detector", rules: ["own-in:vehicle-01/detector", "own-out:vehicle-01/detector", "fan-in-presence:vehicle-01/detector", "fan-in:vehicle-01/detector", "fan-in-reply:vehicle-01/detector", "consume-in:vehicle-01/detector", "consume-out:vehicle-01/detector", "presence-in:vehicle-01/detector", "presence-out:vehicle-01/detector", "contracts-in", "contracts-out"],
      subjects: ["detector"] },
    { id: "tracker", rules: ["own-in:vehicle-01/tracker", "own-out:vehicle-01/tracker", "fan-in-presence:vehicle-01/tracker", "consume-in:vehicle-01/tracker", "consume-out:vehicle-01/tracker", "presence-in:vehicle-01/tracker", "presence-out:vehicle-01/tracker", "contracts-in", "contracts-out"],
      subjects: ["tracker"] },
    { id: "zenwatch", rules: ["own-in:vehicle-01/zenwatch", "own-out:vehicle-01/zenwatch", "fan-in-presence:vehicle-01/zenwatch", "fan-in:vehicle-01/zenwatch", "fan-in-reply:vehicle-01/zenwatch", "consume-in:tool.zenwatch", "consume-out:tool.zenwatch", "presence-in:tool.zenwatch", "presence-out:tool.zenwatch", "admin-read-in:tool.zenwatch", "admin-read-out:tool.zenwatch", "contracts-in", "contracts-out"],
      subjects: ["zenwatch"] },
    { id: "executor", rules: ["own-in:vehicle-01/executor", "own-out:vehicle-01/executor", "fan-in-presence:vehicle-01/executor", "consume-in:vehicle-01/executor", "consume-out:vehicle-01/executor", "presence-in:vehicle-01/executor", "presence-out:vehicle-01/executor", "contracts-in", "contracts-out"],
      subjects: ["executor"] },
    { id: "archive", rules: ["own-in:vehicle-01/archive", "own-out:vehicle-01/archive", "fan-in-presence:vehicle-01/archive", "consume-in:vehicle-01/archive", "consume-out:vehicle-01/archive", "presence-in:vehicle-01/archive", "presence-out:vehicle-01/archive", "contracts-in", "contracts-out"],
      subjects: ["archive"] },
    { id: "ground", rules: ["own-in:ground/fleet-mgr", "own-out:ground/fleet-mgr", "fan-in-presence:ground/fleet-mgr", "own-in:ground/archive", "own-out:ground/archive", "fan-in-presence:ground/archive", "consume-in:ground/archive", "consume-out:ground/archive", "consume-in:tool.ops", "consume-out:tool.ops", "call-in:tool.ops", "call-out:tool.ops", "face-declarations:ground", "face:ground:zk", "face:ground:adv", "face:ground:admin", "face:ground:stream", "face:ground:@stream", "face:ground:state", "face:ground:@state", "face:ground:events"],
      subjects: ["ground"] },
  ],
},
// A far router in a south region (link.v1 §2.5, §8.5, U23): declarations cross on
// interest, and the face's denies keep the denied families off the link. This
// router's own peers and clients stay south, as the `auto` preset places them. On
// the far router, region_name: "ground" (face ground, far ground)
gateway: {
  south: [
    { filters: [{ modes: ["peer", "client"] }] },
    { filters: [{ region_names: ["ground"] }] },
  ],
},
