// zenohd access control, generated by `zenctl acl gen` (zk2 spec §11).
// namespace ""; default_permission deny; 3 subject(s), 18 rule(s), 3 polic(y/ies).
// Compiled from config.v1@sha256:727ff0090b99ad8fc09b5398804d1a14288bebf661f374ec6904351344a1a7b1: regenerate on every contract revision (§11.2).
// Field names: zenoh 1.10 (zenoh-config-1.10.1/src/lib.rs: AclConfig, AclConfigRule,
// AclMessage, InterceptorFlow, AclConfigSubjects, AclConfigPolicyEntry). Merge at the
// router config's top level; rules, subjects and policies are all required. Subjects
// are bound by usrpwd user names (transport/auth/usrpwd) or certificate CNs (mTLS),
// never zids (§11.3). Access control is enforced per hop, and the running block is not
// observable on the bus (§11.3): `zenctl acl gen --check --against` reads this file.
access_control: {
  enabled: true,
  default_permission: "deny",  // §11.2: grants compile to allow rules (RECOMMENDED)
  rules: [
    // own (h-3fa9c2d41b7e/rf0): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:h-3fa9c2d41b7e/rf0", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/**", "zk2/h-3fa9c2d41b7e/rf0/*/@stream/**", "zk2/h-3fa9c2d41b7e/rf0/*/@state/**", "zk2/h-3fa9c2d41b7e/rf0/*/@op/**", "zk2/h-3fa9c2d41b7e/rf0/@zk/**"] },
    // own (h-3fa9c2d41b7e/rf0): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:h-3fa9c2d41b7e/rf0", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/**", "zk2/h-3fa9c2d41b7e/rf0/*/@stream/**", "zk2/h-3fa9c2d41b7e/rf0/*/@state/**", "zk2/h-3fa9c2d41b7e/rf0/*/@op/**", "zk2/h-3fa9c2d41b7e/rf0/@zk/**"] },
    // own (h-3fa9c2d41b7e/sat0): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:h-3fa9c2d41b7e/sat0", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/sat0/**", "zk2/h-3fa9c2d41b7e/sat0/*/@stream/**", "zk2/h-3fa9c2d41b7e/sat0/*/@state/**", "zk2/h-3fa9c2d41b7e/sat0/*/@op/**", "zk2/h-3fa9c2d41b7e/sat0/@zk/**"] },
    // own (h-3fa9c2d41b7e/sat0): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:h-3fa9c2d41b7e/sat0", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/sat0/**", "zk2/h-3fa9c2d41b7e/sat0/*/@stream/**", "zk2/h-3fa9c2d41b7e/sat0/*/@state/**", "zk2/h-3fa9c2d41b7e/sat0/*/@op/**", "zk2/h-3fa9c2d41b7e/sat0/@zk/**"] },
    // consume (tool.ops): §11.1 Consume: subscribe or GET on what the bindings name, one selector per bound provider (R1), R2's parameter bindings applied
    { id: "consume-in:tool.ops", permission: "allow", flows: ["ingress"],
      messages: ["declare_subscriber", "query"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/state/status", "zk2/h-3fa9c2d41b7e/rf0/config.v1/state/view"] },
    // consume (tool.ops): §11.1 Consume, egress: the samples and replies those selectors receive
    { id: "consume-out:tool.ops", permission: "allow", flows: ["egress"],
      messages: ["put", "delete", "reply"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/state/status", "zk2/h-3fa9c2d41b7e/rf0/config.v1/state/view"] },
    // presence (tool.ops): §11.1 Consume, Call and Tool (0.8, 0.14, 0.27), §8.1, §3.3: liveliness reads and the descriptor's GET and subscription on the `@zk` subtree of each service bound, called or inspected. A refused read is answered complete and empty, so a reader the grants refuse would attribute silence to absence (§11.3)
    { id: "presence-in:tool.ops", permission: "allow", flows: ["ingress"],
      messages: ["declare_liveliness_subscriber", "liveliness_query", "query", "declare_subscriber"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/@zk/**"] },
    // presence (tool.ops): §11.1 (0.8, 0.14, 0.27), §8.1, §3.3, egress: the tokens and the descriptors those reads receive
    { id: "presence-out:tool.ops", permission: "allow", flows: ["egress"],
      messages: ["liveliness_token", "reply", "put"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/@zk/**"] },
    // call (tool.ops): §11.1 Call: query on the specific `…/@op/<op>` keys called
    { id: "call-in:tool.ops", permission: "allow", flows: ["ingress"],
      messages: ["query"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/duty", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/radio", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/confirm", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/cancel", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/extend"] },
    // call (tool.ops): §11.1 Call, egress: the replies, a server's refusal included (O2, O3)
    { id: "call-out:tool.ops", permission: "allow", flows: ["egress"],
      messages: ["reply"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/duty", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/radio", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/confirm", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/cancel", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/extend"] },
    // consume (tool.admin): §11.1 Consume: subscribe or GET on what the bindings name, one selector per bound provider (R1), R2's parameter bindings applied
    { id: "consume-in:tool.admin", permission: "allow", flows: ["ingress"],
      messages: ["declare_subscriber", "query"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/state/status", "zk2/h-3fa9c2d41b7e/rf0/config.v1/state/view", "zk2/h-3fa9c2d41b7e/sat0/config.v1/state/status", "zk2/h-3fa9c2d41b7e/sat0/config.v1/state/view"] },
    // consume (tool.admin): §11.1 Consume, egress: the samples and replies those selectors receive
    { id: "consume-out:tool.admin", permission: "allow", flows: ["egress"],
      messages: ["put", "delete", "reply"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/state/status", "zk2/h-3fa9c2d41b7e/rf0/config.v1/state/view", "zk2/h-3fa9c2d41b7e/sat0/config.v1/state/status", "zk2/h-3fa9c2d41b7e/sat0/config.v1/state/view"] },
    // presence (tool.admin): §11.1 Consume, Call and Tool (0.8, 0.14, 0.27), §8.1, §3.3: liveliness reads and the descriptor's GET and subscription on the `@zk` subtree of each service bound, called or inspected. A refused read is answered complete and empty, so a reader the grants refuse would attribute silence to absence (§11.3)
    { id: "presence-in:tool.admin", permission: "allow", flows: ["ingress"],
      messages: ["declare_liveliness_subscriber", "liveliness_query", "query", "declare_subscriber"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/@zk/**", "zk2/h-3fa9c2d41b7e/sat0/@zk/**"] },
    // presence (tool.admin): §11.1 (0.8, 0.14, 0.27), §8.1, §3.3, egress: the tokens and the descriptors those reads receive
    { id: "presence-out:tool.admin", permission: "allow", flows: ["egress"],
      messages: ["liveliness_token", "reply", "put"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/@zk/**", "zk2/h-3fa9c2d41b7e/sat0/@zk/**"] },
    // call (tool.admin): §11.1 Call: query on the specific `…/@op/<op>` keys called
    { id: "call-in:tool.admin", permission: "allow", flows: ["ingress"],
      messages: ["query"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/cancel", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/confirm", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/extend", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/persist", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/cancel", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/confirm", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/extend", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/persist", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/set/*"] },
    // call (tool.admin): §11.1 Call, egress: the replies, a server's refusal included (O2, O3)
    { id: "call-out:tool.admin", permission: "allow", flows: ["egress"],
      messages: ["reply"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/cancel", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/confirm", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/extend", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/persist", "zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/cancel", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/confirm", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/extend", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/persist", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/set/*"] },
    // contracts: §11.1: contract bundles are open, any principal may hold or fetch `zk2/@zk/contract/**`, because the hash is the check (§8.4)
