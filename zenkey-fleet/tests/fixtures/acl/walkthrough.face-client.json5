    // consume (vehicle-01/archive): §11.1 Consume, egress: the samples and replies those selectors receive
    { id: "consume-out:vehicle-01/archive", permission: "allow", flows: ["egress"],
      messages: ["put", "delete", "reply"],
      key_exprs: ["zk2/ground/fleet-mgr/mission_plan.v1/state/plans/vehicle-01", "zk2/ground/archive/archive.v1/@state/ground/fleet-mgr/mission_plan.v1/state/plans/vehicle-01"] },
    // presence (vehicle-01/archive): §11.1 Consume and Call (0.8, 0.14), §8.1, §3.3: liveliness reads and the descriptor's GET and subscription on the `@zk` subtree of each service named. A refused read is answered complete and empty, so a reader the grants refuse would attribute silence to absence (§11.3)
    { id: "presence-in:vehicle-01/archive", permission: "allow", flows: ["ingress"],
      messages: ["declare_liveliness_subscriber", "liveliness_query", "query", "declare_subscriber"],
      key_exprs: ["zk2/ground/fleet-mgr/@zk/**", "zk2/ground/archive/@zk/**"] },
    // presence (vehicle-01/archive): §11.1 (0.8, 0.14), §8.1, §3.3, egress: the tokens and the descriptors those reads receive
    { id: "presence-out:vehicle-01/archive", permission: "allow", flows: ["egress"],
      messages: ["liveliness_token", "reply", "put"],
      key_exprs: ["zk2/ground/fleet-mgr/@zk/**", "zk2/ground/archive/@zk/**"] },
    // own (ground/fleet-mgr): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:ground/fleet-mgr", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/ground/fleet-mgr/**", "zk2/ground/fleet-mgr/*/@stream/**", "zk2/ground/fleet-mgr/*/@state/**", "zk2/ground/fleet-mgr/*/@op/**", "zk2/ground/fleet-mgr/@zk/**"] },
    // own (ground/fleet-mgr): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:ground/fleet-mgr", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/ground/fleet-mgr/**", "zk2/ground/fleet-mgr/*/@stream/**", "zk2/ground/fleet-mgr/*/@state/**", "zk2/ground/fleet-mgr/*/@op/**", "zk2/ground/fleet-mgr/@zk/**"] },
    // own (ground/archive): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:ground/archive", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/ground/archive/**", "zk2/ground/archive/*/@stream/**", "zk2/ground/archive/*/@state/**", "zk2/ground/archive/*/@op/**", "zk2/ground/archive/@zk/**"] },
    // own (ground/archive): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:ground/archive", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/ground/archive/**", "zk2/ground/archive/*/@stream/**", "zk2/ground/archive/*/@state/**", "zk2/ground/archive/*/@op/**", "zk2/ground/archive/@zk/**"] },
    // consume (ground/archive): §11.1 Consume: subscribe or GET on what the bindings name, one selector per bound provider (R1), R2's parameter bindings applied
    { id: "consume-in:ground/archive", permission: "allow", flows: ["ingress"],
      messages: ["declare_subscriber", "query"],
      key_exprs: ["zk2/ground/fleet-mgr/mission_plan.v1/state/plans/*"] },
    // consume (ground/archive): §11.1 Consume, egress: the samples and replies those selectors receive
