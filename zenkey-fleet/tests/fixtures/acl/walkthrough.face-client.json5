    // call (tool.ops): §11.1 Call: query on the specific `…/@op/<op>` keys called
    { id: "call-in:tool.ops", permission: "allow", flows: ["ingress"],
      messages: ["query"],
      key_exprs: ["zk2/vehicle-01/thruster-l/thruster.v1/@op/arm", "zk2/vehicle-01/thruster-l/thruster.v1/@op/disarm", "zk2/vehicle-01/thruster-r/thruster.v1/@op/arm", "zk2/vehicle-01/thruster-r/thruster.v1/@op/disarm", "zk2/vehicle-01/navigation/nav.v2/@op/set_origin"] },
    // call (tool.ops): §11.1 Call, egress: the replies, a server's refusal included (O2, O3)
    { id: "call-out:tool.ops", permission: "allow", flows: ["egress"],
      messages: ["reply"],
      key_exprs: ["zk2/vehicle-01/thruster-l/thruster.v1/@op/arm", "zk2/vehicle-01/thruster-l/thruster.v1/@op/disarm", "zk2/vehicle-01/thruster-r/thruster.v1/@op/arm", "zk2/vehicle-01/thruster-r/thruster.v1/@op/disarm", "zk2/vehicle-01/navigation/nav.v2/@op/set_origin"] },
    // admin_read (tool.ops): §11.1 Tool (0.15), §4.2: a tool reads the routers' admin space to check S4 and the doctor's router checks; under deny no other grant reaches it. Never namespaced
    { id: "admin-read-in:tool.ops", permission: "allow", flows: ["ingress"],
      messages: ["query"],
      key_exprs: ["@/*/router", "@/*/router/**"] },
    // admin_read (tool.ops): §11.1 Tool (0.15), §4.2, egress: the routers' answers, each checked against its own key
    { id: "admin-read-out:tool.ops", permission: "allow", flows: ["egress"],
      messages: ["reply"],
      key_exprs: ["@/*/router", "@/*/router/**"] },
    // contracts: §11.1: contract bundles are open, any principal may hold or fetch `zk2/@zk/contract/**`, because the hash is the check (§8.4)
    { id: "contracts-in", permission: "allow", flows: ["ingress"],
      messages: ["declare_queryable", "reply", "query"],
      key_exprs: ["zk2/@zk/contract/**"] },
    // contracts: §11.1: contract bundles are open, any principal may hold or fetch `zk2/@zk/contract/**`, because the hash is the check (§8.4)
    { id: "contracts-out", permission: "allow", flows: ["egress"],
      messages: ["query", "reply"],
      key_exprs: ["zk2/@zk/contract/**"] },
    // face_presence (ground): §8.5: no `@zk` traffic across a constrained face. Bindings resolve statically (R7), bundles are held on each side, and presence never crosses
    { id: "face-presence:ground", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/**/@zk/**"] },
    // face_stream (ground): §8.5: `@stream` keys denied across the face unless `link.v1` downsamples them (not modelled here: every one is denied). A named key's frames are queued, not dropped, and every request waits behind them
    { id: "face-stream:ground", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/*/*/*/@stream/**"] },
  ],
