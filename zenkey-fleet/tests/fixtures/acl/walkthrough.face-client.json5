    // own (vehicle-01/archive): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:vehicle-01/archive", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/vehicle-01/archive/**", "zk2/vehicle-01/archive/*/@stream/**", "zk2/vehicle-01/archive/*/@state/**", "zk2/vehicle-01/archive/*/@op/**", "zk2/vehicle-01/archive/@zk/**"] },
    // consume (vehicle-01/archive): §11.1 Consume: subscribe or GET on what the bindings name, one selector per bound provider (R1), R2's parameter bindings applied
    { id: "consume-in:vehicle-01/archive", permission: "allow", flows: ["ingress"],
