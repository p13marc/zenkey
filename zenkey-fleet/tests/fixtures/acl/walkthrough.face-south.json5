    { id: "executor", usernames: ["executor"] },  // runs vehicle-01/executor
    { id: "archive", usernames: ["archive"] },  // runs vehicle-01/archive
    { id: "ground", usernames: ["ground"] },  // runs ground/fleet-mgr, ground/archive, tool.ops
  ],
  policies: [
    { id: "thruster-l", rules: ["deny-write:thruster-l", "deny-read:thruster-l", "deny-receive:thruster-l", "deny-admin-space"],
      subjects: ["thruster-l"] },
    { id: "thruster-r", rules: ["deny-write:thruster-r", "deny-read:thruster-r", "deny-receive:thruster-r", "deny-admin-space"],
      subjects: ["thruster-r"] },
    { id: "teleop", rules: ["deny-write:teleop", "deny-read:teleop", "deny-receive:teleop", "deny-admin-space"],
      subjects: ["teleop"] },
    { id: "autopilot", rules: ["deny-write:autopilot", "deny-read:autopilot", "deny-receive:autopilot", "deny-admin-space"],
      subjects: ["autopilot"] },
    { id: "safety", rules: ["deny-write:safety", "deny-read:safety", "deny-receive:safety", "deny-admin-space"],
      subjects: ["safety"] },
    { id: "navigation", rules: ["deny-write:navigation", "deny-read:navigation", "deny-receive:navigation", "deny-admin-space"],
      subjects: ["navigation"] },
    { id: "cam-front", rules: ["deny-write:cam-front", "deny-read:cam-front", "deny-receive:cam-front", "deny-admin-space"],
      subjects: ["cam-front"] },
    { id: "detector", rules: ["deny-write:detector", "deny-read:detector", "deny-receive:detector", "deny-admin-space"],
      subjects: ["detector"] },
    { id: "tracker", rules: ["deny-write:tracker", "deny-read:tracker", "deny-receive:tracker", "deny-admin-space"],
      subjects: ["tracker"] },
    { id: "executor", rules: ["deny-write:executor", "deny-read:executor", "deny-receive:executor", "deny-admin-space"],
      subjects: ["executor"] },
    { id: "archive", rules: ["deny-write:archive", "deny-read:archive", "deny-receive:archive", "deny-admin-space"],
      subjects: ["archive"] },
    { id: "ground", rules: ["deny-write:ground", "deny-read:ground", "deny-receive:ground", "face-presence:ground", "face-stream:ground", "deny-admin-space"],
      subjects: ["ground"] },
  ],
},
// A far router in a south region (§8.5, U23): declarations cross on interest, and
// the face's denies keep the denied families off the link. This router's own peers
// and clients stay south, as the `auto` preset places them. On the far router:
// region_name: "ground"
gateway: {
  south: [
    { filters: [{ modes: ["peer", "client"] }] },
    { filters: [{ region_names: ["ground"] }] },
  ],
},
