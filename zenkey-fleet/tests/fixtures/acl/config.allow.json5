// zenohd access control, generated by `zenctl acl gen` (zk2 spec §11).
// namespace ""; default_permission allow; 3 subject(s), 7 rule(s), 3 polic(y/ies).
// Compiled from config.v1@sha256:727ff0090b99ad8fc09b5398804d1a14288bebf661f374ec6904351344a1a7b1: regenerate on every contract revision (§11.2).
// Field names: zenoh 1.10 (zenoh-config-1.10.1/src/lib.rs: AclConfig, AclConfigRule,
// AclMessage, InterceptorFlow, AclConfigSubjects, AclConfigPolicyEntry). Merge at the
// router config's top level; rules, subjects and policies are all required. Subjects
// are bound by usrpwd user names (transport/auth/usrpwd) or certificate CNs (mTLS),
// never zids (§11.3). Access control is enforced per hop, and the running block is not
// observable on the bus (§11.3): `zenctl acl gen --check --against` reads this file.
// ! allow_posture: under default_permission allow, zenoh evaluates no allow rule, so each grant is compiled into denies of its complement, from the contracts given (regenerate on every revision). Deny works by inclusion: a put on a wildcard key is in none and reaches subscribers (R6 discards it), and a wildcard call is in none either, so an operation that allows fan-out executes on every provider for a principal never granted it, only its answers denied (O2 refuses the others). A session matching no subject has no policy and is allowed everything, so authentication must refuse it (§11.2, §11.3)
// ! complement_partial [ops]: ops is granted part of zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/* (zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/duty, zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/set/radio), and the rest cannot be denied by inclusion: members no other principal is granted stay readable to it under allow (§11.2, §11.3)
access_control: {
  enabled: true,
  default_permission: "allow",  // §11.2: allow rules are not evaluated; grants compile to denies of their complement
  rules: [
    // deny_admin_space: #684 (F-80, spec amendment 0.12): the routers serve the admin space themselves, so no principal has a reason to declare a queryable under `@/**`; one that does can answer a tool's admin-space read, and turn a check from unobservable into a false clean. Deny works by inclusion: `@/**` covers `@/<zid>/router`. The admin space is never namespaced
    { id: "deny-admin-space", permission: "deny", flows: ["ingress"],
      messages: ["declare_queryable"],
      key_exprs: ["@/**"] },
    // deny_write (ops): §11.2 under allow: Own's complement, every other enrolled service's writes, serving and tokens. A put on a wildcard key is in no deny and gets through: R6 discards it at the consumer (§11.3)
    { id: "deny-write:ops", permission: "deny", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/**", "zk2/h-3fa9c2d41b7e/rf0/*/@stream/**", "zk2/h-3fa9c2d41b7e/rf0/*/@state/**", "zk2/h-3fa9c2d41b7e/rf0/*/@op/**", "zk2/h-3fa9c2d41b7e/rf0/@zk/**", "zk2/h-3fa9c2d41b7e/sat0/**", "zk2/h-3fa9c2d41b7e/sat0/*/@stream/**", "zk2/h-3fa9c2d41b7e/sat0/*/@state/**", "zk2/h-3fa9c2d41b7e/sat0/*/@op/**", "zk2/h-3fa9c2d41b7e/sat0/@zk/**"] },
    // deny_read (ops): §11.2 under allow: the surfaces of other services this principal's grants do not name, from the contracts given. Deny works by inclusion (§11.3): a selector wider than every deny is in none
    { id: "deny-read:ops", permission: "deny", flows: ["ingress"],
      messages: ["declare_subscriber", "query", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/persist", "zk2/h-3fa9c2d41b7e/rf0/config.v1/events/change/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/cancel", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/confirm", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/extend", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/persist", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/set/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/events/change/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/state/status", "zk2/h-3fa9c2d41b7e/sat0/config.v1/state/view", "zk2/h-3fa9c2d41b7e/sat0/@zk/**"] },
    // deny_receive (ops): §11.2 under allow, egress: the same complement toward this principal. A put, a token and a value reply are checked against their own key, so a wildcard subscription or GET does not escape it (measured, #612 FJ7)
    { id: "deny-receive:ops", permission: "deny", flows: ["egress"],
      messages: ["put", "delete", "reply", "liveliness_token"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/@op/persist", "zk2/h-3fa9c2d41b7e/rf0/config.v1/events/change/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/cancel", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/confirm", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/extend", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/persist", "zk2/h-3fa9c2d41b7e/sat0/config.v1/@op/set/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/events/change/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/state/status", "zk2/h-3fa9c2d41b7e/sat0/config.v1/state/view", "zk2/h-3fa9c2d41b7e/sat0/@zk/**"] },
    // deny_write (admin): §11.2 under allow: Own's complement, every other enrolled service's writes, serving and tokens. A put on a wildcard key is in no deny and gets through: R6 discards it at the consumer (§11.3)
    { id: "deny-write:admin", permission: "deny", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/**", "zk2/h-3fa9c2d41b7e/rf0/*/@stream/**", "zk2/h-3fa9c2d41b7e/rf0/*/@state/**", "zk2/h-3fa9c2d41b7e/rf0/*/@op/**", "zk2/h-3fa9c2d41b7e/rf0/@zk/**", "zk2/h-3fa9c2d41b7e/sat0/**", "zk2/h-3fa9c2d41b7e/sat0/*/@stream/**", "zk2/h-3fa9c2d41b7e/sat0/*/@state/**", "zk2/h-3fa9c2d41b7e/sat0/*/@op/**", "zk2/h-3fa9c2d41b7e/sat0/@zk/**"] },
    // deny_read (admin): §11.2 under allow: the surfaces of other services this principal's grants do not name, from the contracts given. Deny works by inclusion (§11.3): a selector wider than every deny is in none
    { id: "deny-read:admin", permission: "deny", flows: ["ingress"],
      messages: ["declare_subscriber", "query", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/events/change/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/events/change/*"] },
    // deny_receive (admin): §11.2 under allow, egress: the same complement toward this principal. A put, a token and a value reply are checked against their own key, so a wildcard subscription or GET does not escape it (measured, #612 FJ7)
    { id: "deny-receive:admin", permission: "deny", flows: ["egress"],
      messages: ["put", "delete", "reply", "liveliness_token"],
      key_exprs: ["zk2/h-3fa9c2d41b7e/rf0/config.v1/events/change/*", "zk2/h-3fa9c2d41b7e/sat0/config.v1/events/change/*"] },
  ],
  subjects: [
    { id: "modem", usernames: ["modem"] },  // runs h-3fa9c2d41b7e/rf0, h-3fa9c2d41b7e/sat0
    { id: "ops", usernames: ["ops"] },  // runs tool.ops
    { id: "admin", usernames: ["admin"] },  // runs tool.admin
  ],
  policies: [
    { id: "modem", rules: ["deny-admin-space"],
      subjects: ["modem"] },
    { id: "ops", rules: ["deny-write:ops", "deny-read:ops", "deny-receive:ops", "deny-admin-space"],
      subjects: ["ops"] },
    { id: "admin", rules: ["deny-write:admin", "deny-read:admin", "deny-receive:admin", "deny-admin-space"],
      subjects: ["admin"] },
  ],
},
