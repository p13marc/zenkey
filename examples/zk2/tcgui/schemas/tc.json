{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tc.json",
  "$comment": "tcgui pilot (#589). Top-level shapes extracted from tcgui-shared; nested types marked $comment are generated by schemars and committed at port time (#614).",
  "$defs": {
    "Empty": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Namespaces": {
      "type": "object",
      "properties": {
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "namespaces"
      ]
    },
    "NetworkInterface": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "namespace": {
          "type": "string"
        },
        "is_up": {
          "type": "boolean"
        },
        "is_oper_up": {
          "type": "boolean"
        },
        "has_tc_qdisc": {
          "type": "boolean"
        },
        "interface_type": {
          "type": "string"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qdisc_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "link_speed_mbps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "duplex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "wifi_signal_dbm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "wifi_tx_bitrate_100kbps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "index",
        "namespace",
        "is_up"
      ]
    },
    "BandwidthUpdate": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "stats": {
          "$ref": "#/$defs/NetworkBandwidthStats"
        }
      },
      "required": [
        "stats"
      ]
    },
    "NetworkBandwidthStats": {
      "type": "object",
      "properties": {
        "rx_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tx_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "rx_packets": {
          "type": "integer",
          "minimum": 0
        },
        "tx_packets": {
          "type": "integer",
          "minimum": 0
        },
        "rx_bytes_per_sec": {
          "type": "number"
        },
        "tx_bytes_per_sec": {
          "type": "number"
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "InterfaceControlRequest": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "Enable",
            "Disable"
          ]
        }
      },
      "required": [
        "operation"
      ]
    },
    "InterfaceControlResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "new_state": {
          "type": "boolean"
        }
      },
      "required": [
        "new_state"
      ]
    },
    "DiagnosticsRequest": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "namespace",
        "interface"
      ]
    },
    "DiagnosticsResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "results": {
          "type": "object"
        }
      },
      "required": [
        "results"
      ]
    },
    "TcNetemConfig": {
      "type": "object",
      "$comment": "loss, delay, duplicate, reorder, corrupt, rate_limit (tcgui-shared TcNetemConfig); generated by schemars at port time"
    },
    "TcConfiguration": {
      "type": "object",
      "$comment": "tcgui-shared TcConfiguration; generated by schemars at port time"
    },
    "TcConfigUpdate": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/TcConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_tc": {
          "type": "boolean"
        }
      },
      "required": [
        "has_tc"
      ]
    },
    "TcStatisticsUpdate": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "stats_basic": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats_queue": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats_rate_est": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PlugState": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "buffering": {
          "type": "boolean"
        },
        "limit_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "since_ms": {
          "type": "integer",
          "minimum": 0
        },
        "buffered_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "buffered_packets": {
          "type": "integer",
          "minimum": 0
        },
        "netem_synthesized": {
          "type": "boolean"
        },
        "plug_parent": {
          "type": "string"
        }
      },
      "required": [
        "buffering"
      ]
    },
    "TcAppliedEvent": {
      "type": "object",
      "properties": {
        "ulid": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/TcNetemConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ulid",
        "timestamp"
      ]
    },
    "TcRequest": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "object",
          "$comment": "TcOperation: ApplyConfig | Apply | Remove"
        }
      },
      "required": [
        "operation"
      ]
    },
    "TcResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "applied_config": {
          "anyOf": [
            {
              "$ref": "#/$defs/TcConfiguration"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TcPlugRequest": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "object",
          "$comment": "TcPlugOperation: Buffer | ReleaseOne | Release | SetLimit | Remove"
        }
      },
      "required": [
        "operation"
      ]
    },
    "PlugResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlugState"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NetworkScenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "loop_scenario": {
          "type": "boolean"
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        },
        "modified_at": {
          "type": "integer",
          "minimum": 0
        },
        "metadata": {
          "type": "object"
        },
        "cleanup_on_failure": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "steps"
      ]
    },
    "CustomPreset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/TcNetemConfig"
        }
      },
      "required": [
        "id",
        "name",
        "config"
      ]
    },
    "ScenarioExecutionUpdate": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "execution": {
          "type": "object",
          "$comment": "tcgui-shared ScenarioExecution"
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "execution"
      ]
    },
    "ScenarioPut": {
      "type": "object",
      "properties": {
        "scenario": {
          "$ref": "#/$defs/NetworkScenario"
        }
      },
      "required": [
        "scenario"
      ]
    },
    "ScenarioAck": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "ExecutionControl": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "Start",
            "Stop",
            "Pause",
            "Resume"
          ]
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "loop_override": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation"
      ]
    },
    "ExecutionAck": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "execution": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TcError": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "validation",
            "kernel",
            "not_found",
            "busy"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    }
  }
}
