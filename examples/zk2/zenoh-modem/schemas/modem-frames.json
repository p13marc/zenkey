        {"name": "fragment_timeouts_total", "type": "counter", "width": 32, "optional": true},
        {"name": "fragment_oversize_total", "type": "counter", "width": 32, "optional": true},
        {"name": "fragment_malformed_total", "type": "counter", "width": 32, "optional": true},
        {"name": "compress_compressed_total", "type": "counter", "width": 32, "optional": true},
        {"name": "compress_stored_total", "type": "counter", "width": 32, "optional": true},
        {"name": "compress_bytes_saved_total", "type": "counter", "width": 32, "optional": true},
