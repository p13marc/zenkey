{
  "description": "modem.v3's frame records (core section 7.6, 7.7; telemetry.v2, #983 T4). Every field is optional: a device that cannot answer writes it absent, never 0. The ranges and widths are illustrative. Since revision 3.3 the frames of these types are deprecated, and modem-readings.json carries the readings at zenoh-modem's ranges (#991). A group frame's counters are 32 bits, the kernel's octet counters 40; frames/message's are 24.",
  "types": {
    "LinkReadings": {
      "description": "frames/link: sdu/dropped_total, sched/queue_depth, air/duty_cycle_available and air/duty_cycle_wait_ms, as core section 7.7's fixtures' Link (63 bits)",
      "fields": [
        {"name": "dropped", "type": "counter", "width": 32, "optional": true},
        {"name": "queue_depth", "type": "int", "minimum": 0, "maximum": 1022, "reserved": ["out_of_range"], "optional": true},
        {"name": "duty_available", "type": "int", "minimum": 0, "maximum": 1, "optional": true},
        {"name": "duty_wait_ms", "type": "fixed", "minimum": "0", "maximum": "3600000", "resolution": "100", "reserved": ["out_of_range"], "optional": true}
      ]
    },
    "Sdu": {
      "description": "frames/sdu: the SDU plane's nine counters",
      "fields": [
        {"name": "tx_sdus_total", "type": "counter", "width": 32, "optional": true},
        {"name": "tx_bytes_total", "type": "counter", "width": 32, "optional": true},
        {"name": "rx_sdus_total", "type": "counter", "width": 32, "optional": true},
        {"name": "rx_bytes_total", "type": "counter", "width": 32, "optional": true},
        {"name": "dropped_total", "type": "counter", "width": 32, "optional": true},
        {"name": "tx_failed_total", "type": "counter", "width": 32, "optional": true},
        {"name": "rx_unroutable_total", "type": "counter", "width": 32, "optional": true},
        {"name": "rx_oversize_total", "type": "counter", "width": 32, "optional": true},
        {"name": "tx_oversize_total", "type": "counter", "width": 32, "optional": true}
      ]
    },
    "Sched": {
      "description": "frames/sched: the scheduler's counters, its queue and the lane backlog",
      "fields": [
        {"name": "dropped_total", "type": "counter", "width": 32, "optional": true},
        {"name": "stale_total", "type": "counter", "width": 32, "optional": true},
        {"name": "peerless_total", "type": "counter", "width": 32, "optional": true},
        {"name": "queue_depth", "type": "int", "minimum": 0, "maximum": 1022, "reserved": ["out_of_range"], "optional": true},
        {"name": "lane_backlog_bytes", "type": "int", "minimum": 0, "maximum": 1048574, "reserved": ["out_of_range"], "optional": true},
        {"name": "lane_backlog_drain_ms", "type": "fixed", "minimum": "0", "maximum": "3600000", "resolution": "100", "reserved": ["out_of_range"], "optional": true}
      ]
    },
    "Air": {
      "description": "frames/air: what the module frames and the medium spends: frames, listen-before-talk, airtime, ARQ, slot waste, receive errors, the duty cycle",
      "fields": [
        {"name": "tx_frames_total", "type": "counter", "width": 32, "optional": true},
        {"name": "rx_frames_total", "type": "counter", "width": 32, "optional": true},
        {"name": "cad_deferrals_total", "type": "counter", "width": 32, "optional": true},
        {"name": "cad_forced_total", "type": "counter", "width": 32, "optional": true},
        {"name": "airtime_ms_total", "type": "counter", "width": 32, "optional": true},
        {"name": "retransmits_total", "type": "counter", "width": 32, "optional": true},
        {"name": "bytes_wasted_total", "type": "counter", "width": 32, "optional": true},
        {"name": "rx_errors_total", "type": "counter", "width": 32, "optional": true},
        {"name": "duty_cycle_available", "type": "int", "minimum": 0, "maximum": 1, "optional": true},
        {"name": "duty_cycle_wait_ms", "type": "fixed", "minimum": "0", "maximum": "3600000", "resolution": "100", "reserved": ["out_of_range"], "optional": true}
