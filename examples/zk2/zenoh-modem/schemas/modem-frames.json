        {"name": "latency", "type": "fixed", "minimum": "0", "maximum": "60000000", "resolution": "100", "reserved": ["out_of_range"], "optional": true},
        {"name": "resources", "type": "int", "minimum": 0, "maximum": 100, "optional": true},
