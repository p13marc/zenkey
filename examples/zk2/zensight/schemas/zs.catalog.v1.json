{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zs.catalog.v1.json",
  "$comment": "The catalog's documents, from zensight-common/src/entity.rs, relation.rs, incident.rs, impact.rs, ack.rs and silence.rs. Faithful except for the identity fields, which follow r3.2 §3.11 (payloads carry identities as structured fields, never as key strings). Each such field says what it was in v1. Those renames ARE the migration debt the README lists.",
  "$defs": {
    "NameVal": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "last_seen": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "provenance",
        "last_seen"
      ]
    },
    "MemberClaim": {
      "description": "One evidence claim merged into an entity. v1: (sensor, source); zk2 names the evidence publisher by (system, service).",
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "service": {
          "description": "v1 `sensor` (the producer).",
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "rule": {
          "type": "string",
          "enum": [
            "host_id",
            "mac_ip",
            "fqdn",
            "hostname"
          ]
        },
        "confidence": {
          "type": "number"
        },
        "last_seen": {
          "type": "integer"
        }
      },
      "required": [
        "system",
        "service",
        "source",
        "rule",
        "confidence",
        "last_seen"
      ]
    },
    "HostEntity": {
      "type": "object",
      "properties": {
        "entity_id": {
          "description": "h-<12hex>; equal to the host's hostid.v1 system name when a member reported a machine id.",
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host_id": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "ips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "macs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "container_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "systems": {
          "description": "The systems whose self-reports resolved to this entity: the system -> entity join (RFC 06 §5.1). v1 `origins` (entity.rs:207).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hostname": {
          "type": "string"
        },
        "fqdn": {
          "type": "string"
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NameVal"
          }
        },
        "vendor": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberClaim"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "online",
            "degraded",
            "offline",
            "unknown"
          ]
        },
        "last_updated": {
          "type": "integer"
        }
      },
      "required": [
        "entity_id",
        "last_updated"
      ]
    },
    "AliasRecord": {
      "type": "object",
      "properties": {
        "old_id": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "last_updated": {
          "type": "integer"
        }
      },
      "required": [
        "old_id",
        "entity_id",
        "last_updated"
      ]
    },
    "PdnsRecord": {
      "type": "object",
      "properties": {
        "ip": {
          "description": "The real address; the key carries its slug.",
          "type": "string"
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NameVal"
          }
        },
        "last_updated": {
          "type": "integer"
        }
      },
      "required": [
        "ip",
        "last_updated"
      ]
    },
    "RelationKind": {
      "type": "string",
      "enum": [
        "hosts",
        "runs",
        "gateway_of",
        "probes",
        "l2_adjacent"
      ]
    },
    "Endpoint": {
      "description": "serde externally tagged, snake_case.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "object",
              "properties": {
                "entity_id": {
                  "type": "string"
                }
              },
              "required": [
                "entity_id"
              ]
            }
          },
          "required": [
            "entity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "external": {
              "type": "object",
              "properties": {
                "ip": {
                  "type": "string"
                },
                "mac": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "external"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Observer": {
      "description": "Who still claims an edge. v1: {sensor, origin} (relation.rs:306-311).",
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "required": [
        "system",
        "service"
      ]
    },
    "Edge": {
      "description": "The catalog's conclusion: one relationship, both ends resolved. edge_id = \"e-\" ++ hex(fnv1a_64(kind 0x1f repr(from) 0x1f repr(to))), repr(Entity) = \"e:\" entity_id, repr(External) = \"x:\" ip \"|\" mac \"|\" name (RFC 11 §3.3; test vector e-2879d4667f9d946d).",
      "type": "object",
      "properties": {
        "edge_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RelationKind"
        },
        "from": {
          "$ref": "#/$defs/Endpoint"
        },
        "to": {
          "$ref": "#/$defs/Endpoint"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "observers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observer"
          }
        },
        "last_updated": {
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "kind",
        "from",
        "to",
        "last_updated"
      ]
    },
    "AssertionKind": {
      "type": "string",
      "enum": [
        "link",
        "unlink"
      ]
    },
    "OperatorAssertion": {
      "type": "object",
      "properties": {
        "id": {
          "description": "\"<kind>-<old>-<new>\" (entity.rs:117): two system names packed into one key chunk. Kept because it is stable and re-derivable, but see migration debt.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssertionKind"
        },
        "old": {
          "description": "A system name (v1: an origin).",
          "type": "string"
        },
        "new": {
          "type": "string"
        },
        "asserted_at": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        },
        "by": {
          "description": "zk2 addition: the O7 call-metadata actor of the link/unlink call. v1 recorded no author for assertions.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "old",
        "new",
        "asserted_at"
      ]
    },
    "AlertRef": {
      "description": "One alarm, by its bus coordinates. v1 packed these into one key chunk \"<origin>.<producer>.<alert_key>\" split on the first two dots (alert.rs:317-409), which breaks on a dotted service such as snmp.router01 (Gap G4). The interface is always alarms.v1.",
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "alert_key": {
          "type": "string"
        }
      },
      "required": [
        "system",
        "service",
        "alert_key"
      ]
    },
    "AlertSite": {
      "description": "v1 AlertSite {entity_id, origin, alert_key} (impact.rs:77-81) has no producer, so it could not name the alarm. zk2 adds the service.",
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "alert_key": {
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "system",
        "service",
        "alert_key"
      ]
    },
    "Cause": {
      "description": "serde externally tagged, snake_case.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "object",
              "properties": {
                "entity_id": {
                  "type": "string"
                }
              },
              "required": [
                "entity_id"
              ]
            }
          },
          "required": [
            "entity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "alert": {
              "$ref": "#/$defs/AlertSite"
            }
          },
          "required": [
            "alert"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "Incident": {
      "type": "object",
      "properties": {
        "id": {
          "description": "inc-<entity_id>, or inc-<system> when the system resolves to no entity. Also the key's {incident_id}.",
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "systems": {
          "description": "Every system contributing a firing alarm. v1 `origins` (incident.rs:50).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "started": {
          "type": "integer"
        },
        "last_change": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        },
        "alerts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlertRef"
          }
        },
        "symptom_of": {
          "$ref": "#/$defs/Cause"
        },
        "impacted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acked": {
          "type": "integer",
          "minimum": 0
        },
        "silenced": {
          "type": "integer",
          "minimum": 0
        },
        "last_updated": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "systems",
        "severity",
        "started",
        "last_change",
        "summary",
        "alerts",
        "acked",
        "silenced",
        "last_updated"
      ]
    },
    "AlertAck": {
      "description": "An acknowledgement applies only while a firing alarm with timestamp <= fired_at exists (ack.rs:12-30): an orphan is inert, and a re-fire is not acknowledged.",
      "type": "object",
      "properties": {
        "alert_ref": {
          "$ref": "#/$defs/AlertRef"
        },
        "fired_at": {
          "type": "integer"
        },
        "by": {
          "description": "The O7 call-metadata actor (v1: the ?actor= selector parameter). Claimed, not authenticated.",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "at": {
          "type": "integer"
        }
      },
      "required": [
        "alert_ref",
        "fired_at",
        "by",
        "at"
      ]
    },
    "MatchOp": {
      "type": "string",
      "enum": [
        "eq",
        "regex"
      ]
    },
    "Matcher": {
      "type": "object",
      "properties": {
        "name": {
          "description": "system | service | rule | labels.<name>. v1 matched origin | producer | source (silence.rs:117); `source` disappears with device-as-service, because the device is the service.",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/MatchOp"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "Silence": {
      "type": "object",
      "properties": {
        "id": {
          "description": "ULID; the key's {id}.",
          "type": "string"
        },
        "matchers": {
          "description": "All must match; an empty set matches nothing.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Matcher"
          }
        },
        "starts_at": {
          "type": "integer"
        },
        "ends_at": {
          "type": "integer"
        },
        "by": {
          "description": "The O7 call-metadata actor.",
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "matchers",
        "starts_at",
        "ends_at",
        "by"
      ]
    },
    "LinkRequest": {
      "description": "Was ?old=<origin>;new=<origin>.",
      "type": "object",
      "properties": {
        "old": {
          "type": "string"
        },
        "new": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "old",
        "new"
      ]
    },
    "AckRequest": {
      "description": "Was ?ref=<origin>.<producer>.<alert_key>;note=. The server looks up the firing alarm and records its timestamp as fired_at.",
      "type": "object",
      "properties": {
        "alert_ref": {
          "$ref": "#/$defs/AlertRef"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "alert_ref"
      ]
    },
    "SilenceRequest": {
      "description": "Silence without `by`, which comes from the call metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "matchers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Matcher"
          }
        },
        "starts_at": {
          "type": "integer"
        },
        "ends_at": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "matchers",
        "starts_at",
        "ends_at"
      ]
    },
    "IdRequest": {
      "description": "Was ?id=<ulid>.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "NamesRequest": {
      "description": "Was ?ip=.",
      "type": "object",
      "properties": {
        "ip": {
          "type": "string"
        }
      },
      "required": [
        "ip"
      ]
    },
    "CatalogError": {
      "description": "The app error detail (O3). v1 registered error/catalog/not-firing and error/catalog/publish; v1's `serialize` becomes the core `internal`, and the closed gate the core `unavailable` with cause config.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "not_firing",
            "publish"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ]
    }
  }
}
