{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zs.historian.v1.json",
  "$comment": "The historian's request and reply shapes, from zensight-common/src/history.rs and historian.toml. v1 carried the query in selector parameters and named a series (origin, producer, subject). zk2 names it (system, service, interface, resource), the key minus the kind chunk, still derivable from a sample alone. Replies are per series (replies = many), so the per-reply envelope (step_s, partial, covers_from) moves onto each series. RangeReply.historian / TimelineReply.historian go: under O6 a reply rides the operation's concrete key, which names the answering historian.",
  "$defs": {
    "SeriesKind": {
      "type": "string",
      "enum": [
        "counter",
        "gauge",
        "bool"
      ]
    },
    "Aggregate": {
      "type": "string",
      "enum": [
        "raw",
        "avg",
        "min",
        "max",
        "last",
        "rate"
      ]
    },
    "SeriesSelector": {
      "description": "Which series. Absent fields match everything; `resource` is a key expression over the resource path (** allowed). v1: ?origin=<h-... or *>;producer=;subject= joined into one pattern (zensight-historian/src/query/range.rs:84-91).",
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "interface": {
          "description": "An interface major, e.g. zs.sysinfo.v1.",
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      }
    },
    "RangeRequest": {
      "type": "object",
      "properties": {
        "series": {
          "$ref": "#/$defs/SeriesSelector"
        },
        "from": {
          "description": "Epoch ms.",
          "type": "integer"
        },
        "to": {
          "type": "integer"
        },
        "step": {
          "description": "Seconds, clamped to a tier: <60 the per-second ring, <3600 the minute tier, else the hour tier.",
          "type": "integer",
          "minimum": 1
        },
        "agg": {
          "$ref": "#/$defs/Aggregate"
        },
        "limit": {
          "description": "Points; default 5000, max 20000.",
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "cursor": {
          "description": "Opaque value cursor from a previous reply's next_cursor. App-level paging: the core has none (r3.2 U10, §8).",
          "type": "string"
        }
      },
      "required": [
        "series",
        "from",
        "to"
      ]
    },
    "Point": {
      "description": "(epoch_ms, value), a 2-tuple as serde writes (i64, f64). prefixItems: Gap G12 asks S7 to settle the zk2 subset of JSON Schema.",
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "RangeSeries": {
      "description": "One series' points from one historian, one reply each.",
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SeriesKind"
        },
        "unit": {
          "type": "string"
        },
        "agg": {
          "description": "The aggregate actually applied, which is not always the one requested.",
          "$ref": "#/$defs/Aggregate"
        },
        "step_s": {
          "description": "Seconds per point after clamping to a tier.",
          "type": "integer"
        },
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        },
        "partial": {
          "description": "The walk stopped before completing this series: limit spent, or the tier could not cover the window (RFC 05 §3.2 marker).",
          "type": "boolean"
        },
        "covers_from": {
          "description": "RFC 3339; present only when the tier's oldest instant is later than `from`.",
          "type": "string"
        },
        "next_cursor": {
          "description": "Present on the last reply of a page that stopped at `limit`. v1 spelled it \"<points>:<origin>/<producer>/<subject>\" (range.rs:187), a key-shaped cursor; it stays opaque here.",
          "type": "string"
        },
        "scanned": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        }
      },
      "required": [
        "system",
        "service",
        "interface",
        "resource",
        "kind",
        "agg",
        "step_s",
        "from",
        "to",
        "partial",
        "points"
      ]
    },
    "SeriesRequest": {
      "type": "object",
      "properties": {
        "series": {
          "$ref": "#/$defs/SeriesSelector"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "cursor": {
          "type": "string"
        }
      }
    },
    "SeriesInfo": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SeriesKind"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "system",
        "service",
        "interface",
        "resource",
        "kind"
      ]
    },
    "TimelineKind": {
      "type": "string",
      "enum": [
        "event",
        "alert"
      ]
    },
    "TimelineRequest": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineKind"
          }
        },
        "system": {
          "type": "string"
        },
        "after_uid": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TimelineEntry": {
      "description": "One occurrence (a trap) or alarm transition, newest first. v1 carried `origin` and the FULL key (history.rs:306-308), and the persisted uid hashed that key string (zensight-store/src/timeline.rs:74-76), so every stored uid changes on migration.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "ts": {
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/TimelineKind"
        },
        "system": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "uid",
        "ts",
        "kind",
        "system",
        "service",
        "interface",
        "resource",
        "active"
      ]
    },
    "TierRows": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "tier",
        "rows"
      ]
    },
    "HistorianStats": {
      "type": "object",
      "properties": {
        "series": {
          "type": "integer",
          "minimum": 0
        },
        "rows_by_tier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TierRows"
          }
        },
        "db_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_total": {
          "type": "integer",
          "minimum": 0
        },
        "last_prune_ms": {
          "type": "integer",
          "minimum": 0
        },
        "oldest_ts": {
          "type": "integer"
        },
        "stored_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "ceiling_prunes_total": {
          "type": "integer",
          "minimum": 0
        },
        "reordered_total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "series",
        "rows_by_tier",
        "db_bytes",
        "dropped_total"
      ]
    },
    "HistorianError": {
      "description": "v1 registered error/historian/{range,series,timeline,stats}: a store read failed or a reply could not be encoded. The encoding half is the core `internal`; the store half stays an app detail. A declared-but-unbuilt timeline answers the core `unavailable`, cause build (v1 error/unsupported).",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "store"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ]
    }
  }
}
