on":"drop","deprecated":null,"encoding":"json","epoch":null,"express":false,"gate":[],"history":null,"kind":"stream","optional":false,"params":{"stream":"string"},"priority":"data","rate":null,"reliability":"best_effort","retention_s":null,"template":"streams/{stream}/stats/rc_drops","token":"stream","type":{"kind":"jsonschema","name":"telemetry.v1.Point","schema":"sha256:3d6276dd302873ca5938013a44d460267971123fd25500f189e30be718f9dc1e"}},{"annotations":{},"attachment":null,"attachment_encoding":null,"cardinality":64,"congestion":"drop","deprecated":null,"encoding":"json","epoch":null,"express":false,"gate":[],"history":null,"kind":"stream","optional":false,"params":{"stream":"string"},"priority":"data","rate":null,"reliability":"best_effort","retention_s":null,"template":"streams/{stream}/stats/sink_queue","token":"stream","type":{"kind":"jsonschema","name":"telemetry.v1.Point","schema":"sha256:3d6276dd302873ca5938013a44d460267971123fd25500f189e30be718f9dc1e"}},{"annotations":{},"attachment":null,"attachment_encoding":null,"cardinality":64,"congestion":"drop","deprecated":null,"encoding":"json","epoch":null,"express":false,"gate":[],"history":null,"kind":"stream","optional":false,"params":{"stream":"string"},"priority":"data","rate":null,"reliability":"best_effort","retention_s":null,"template":"streams/{stream}/stats/viewers","token":"stream","type":{"kind":"jsonschema","name":"telemetry.v1.Point","schema":"sha256:3d6276dd302873ca5938013a44d460267971123fd25500f189e30be718f9dc1e"}}],"schemas":[{"id":"sha256:1f4bfb2ea7eac3e19f2702003d2d8433278b76e66d121873dfcad7f5e11f8446","kind":"jsonschema","name":"zs.common"},{"id":"sha256:3d6276dd302873ca5938013a44d460267971123fd25500f189e30be718f9dc1e","kind":"jsonschema","name":"telemetry.v1"},{"id":"sha256:6ae057f8dcc3df3a332279827810543993ccb2995bffd04dda05da4f49576081","kind":"jsonschema","name":"zs.parallax.v1"}],"uses":["freshness.v1","media.v1","telemetry.v1"]},"extras":{},"schemas":{"sha256:1f4bfb2ea7eac3e19f2702003d2d8433278b76e66d121873dfcad7f5e11f8446":{"data":{"$comment":"ZenSight types shared by several contracts: zs.thresholds.v1 and zs.desired.v1 must agree on ThresholdsConfig, so both list this file unchanged (Gap G12). Faithful to zensight-common/src/threshold.rs, comparison.rs, alert.rs (AlertSeverity) and desired.rs (AppliedConfig).","$defs":{"Ack":{"description":"A write landed. v1 declared Ack without a schema ('ad-hoc JSON on the wire', zensight-common/src/schema.rs:225). In zk2 success is a value reply and failure a reply_err (O3), so nothing but an optional note remains.","properties":{"message":{"type":"string"}},"type":"object"},"AppliedConfig":{"description":"What is actually in force for one reconcilable topic, and why (desired.v1's observed revision: desired_timestamp).","properties":{"applied_at":{"type":"integer"},"desired_timestamp":{"description":"HLC timestamp of the applied desired sample (source = desired only).","type":"string"},"effective_json":{"description":"The document in force, JSON-encoded as a string. Its real type is the topic's.","type":"string"},"last_rejected":{"$ref":"#/$defs/RejectedDesired"},"source":{"$ref":"#/$defs/AppliedSource"},"topic":{"description":"Repeats the key's {topic} (migration debt; tcgui gap 1).","type":"string"}},"required":["topic","source","applied_at","effective_json"],"type":"object"},"AppliedSource":{"enum":["file","desired","rpc"],"type":"string"},"ComparisonOp":{"description":"Serialized in PascalCase (no serde rename); default GreaterThan.","enum":["GreaterThan","GreaterOrEqual","LessThan","LessOrEqual","Equal","NotEqual"],"type":"string"},"Empty":{"additionalProperties":false,"properties":{},"type":"object"},"RejectedDesired":{"properties":{"at":{"type":"integer"},"error":{"type":"string"},"timestamp":{"description":"The rejected sample's HLC timestamp, when it carried one.","type":"string"}},"required":["at","error"],"type":"object"},"Severity":{"description":"AlertSeverity; serde default warning.","enum":["info","warning","critical"],"type":"string"},"ThresholdRule":{"properties":{"clear":{"description":"Value hysteresis, on the quiet side of value.","type":"number"},"for_secs":{"minimum":0,"type":"integer"},"labels":{"additionalProperties":{"type":"string"},"description":"Label globs, all of which must match. v1 proxies matched `source` here; a device service no longer needs to.","type":"object"},"metric":{"description":"Glob over the resource path the service publishes (`if/*/in_errors.rate`). Under zk2 the paths change (the device leaves for the service name, rest families move under metrics/), so v1 rule sets need rewriting (migration debt).","type":"string"},"name":{"description":"Stable identity; becomes the alarm rule `threshold:<name>`.","type":"string"},"op":{"$ref":"#/$defs/ComparisonOp"},"recover_after_secs":{"minimum":0,"type":"integer"},"severity":{"$ref":"#/$defs/Severity"},"summary":{"type":"string"},"value":{"type":"number"}},"required":["name","metric","value"],"type":"object"},"ThresholdsConfig":{"description":"The whole rule set one service evaluates, set wholesale (#928, #931). Every field is serde-defaulted.","properties":{"default_for_secs":{"minimum":0,"type":"integer"},"default_recover_after_secs":{"minimum":0,"type":"integer"},"rules":{"items":{"$ref":"#/$defs/ThresholdRule"},"type":"array"}},"type":"object"}},"$id":"zs.common.json","$schema":"https://json-schema.org/draft/2020-12/schema"},"kind":"jsonschema"},"sha256:3d6276dd302873ca5938013a44d460267971123fd25500f189e30be718f9dc1e":{"data":{"$comment":"The telemetry.v1 profile's self-describing point (r3.2 §4.9), written in the jsonschema kind because ZenSight's wire is serde's internally tagged TelemetryValue in CBOR (zensight-common/src/telemetry.rs:105-134, RFC 11 §4). r3.2 imagines a protobuf oneof: see Gaps G12/G13. Every contract that carries points lists THIS file unchanged, so the type identity (the file's sha256) is shared. Compared with v1's TelemetryPoint, `source` and `metric` are gone: they repeated the key's system/service and resource (r3.2 §3.11).","$defs":{"telemetry.v1.Histogram":{"description":"Fixed buckets, cumulative since the producer's instance started (RFC 11 §4; zensight-common/src/histogram.rs). counts is per bucket, NOT cumulative, one longer than buckets, overflow last. buckets restate the resource's telemetry.buckets bit for bit; +Inf is implicit.","properties":{"buckets":{"items":{"type":"number"},"type":"array"},"count":{"minimum":0,"type":"integer"},"counts":{"items":{"minimum":0,"type":"integer"},"type":"array"},"sum":{"type":"number"}},"required":["buckets","counts","count","sum"],"type":"object"},"telemetry.v1.Point":{"description":"One measurement. The series is named by the key: (system, service, interface, resource).","properties":{"labels":{"additionalProperties":{"type":"string"},"description":"Context that is not identity: an OID, an interface description, the original (unslugged) gNMI path.","type":"object"},"timestamp":{"description":"Unix epoch milliseconds when the measurement was taken (not when it was published).","type":"integer"},"unit":{"description":"UCUM-style unit (By, By/s, 1/s, %, s). Absent means unknown, never dimensionless. The resource's telemetry.unit annotation, when declared, is authoritative.","type":"string"},"value":{"$ref":"#/$defs/telemetry.v1.Value"}},"required":["timestamp","value"],"type":"object"},"telemetry.v1.Value":{"description":"Internally tagged: {\"type\": <kind>, \"value\": ...}. The tag is the resource's telemetry.kind spelled on the wire (boolean for bool). A resource without telemetry.kind (the rest-parameter families) is self-described by this tag alone.","oneOf":[{"properties":{"type":{"const":"counter"},"value":{"minimum":0,"type":"integer"}},"required":["type","value"],"type":"object"},{"properties":{"type":{"const":"gauge"},"value":{"type":"number"}},"required":["type","value"],"type":"object"},{"properties":{"type":{"const":"text"},"value":{"type":"string"}},"required":["type","value"],"type":"object"},{"properties":{"type":{"const":"boolean"},"value":{"type":"boolean"}},"required":["type","value"],"type":"object"},{"properties":{"type":{"const":"binary"},"value":{"description":"serde's Vec<u8>: an array of byte values in both JSON and CBOR, not a CBOR byte string (Gap G9).","items":{"maximum":255,"minimum":0,"type":"integer"},"type":"array"}},"required":["type","value"],"type":"object"},{"properties":{"type":{"const":"histogram"},"value":{"$ref":"#/$defs/telemetry.v1.Histogram"}},"required":["type","value"],"type":"object"}]}},"$id":"telemetry.v1.json","$schema":"https://json-schema.org/draft/2020-12/schema"},"kind":"jsonschema"},"sha256:6ae057f8dcc3df3a332279827810543993ccb2995bffd04dda05da4f49576081":{"data":{"$comment":"parallax's documents, faithful to zensight-common/src/stream.rs and discovery.rs. FrameMeta is CBOR on the wire and pinned byte for byte by a conformance corpus shared with the parallax repository (stream.rs:97-131): field order and the omission of absent timestamps are wire shape. This schema cannot express either rule, and draft 0 does not say how an attachment is encoded when the payload is raw (Gap G8).","$defs":{"DiscoveredStream":{"properties":{"address":{"type":"string"},"attributes":{"additionalProperties":{"type":"string"},"type":"object"},"name":{"type":"string"},"suggested":{"type":"string"},"url":{"type":"string"},"via":{"type":"string"}},"required":["via","address","suggested"],"type":"object"},"FrameMeta":{"properties":{"dts_ns":{"description":"Omitted when equal to pts_ns (a producer-side elision).","minimum":0,"type":"integer"},"duration_ns":{"minimum":0,"type":"integer"},"height":{"minimum":0,"type":"integer"},"keyframe":{"type":"boolean"},"pts_ns":{"minimum":0,"type":"integer"},"sequence":{"description":"Monotonic per stream; a gap means dropped frames.","minimum":0,"type":"integer"},"width":{"minimum":0,"type":"integer"}},"required":["keyframe","sequence","width","height"],"type":"object"},"MediaReceiverReport":{"description":"Receiver feedback for one @stream key (RFC 07 §1.1): a snapshot with cumulative counters, so a retry repeats a statement. Timing fields absent = not measured.","properties":{"codec":{"type":"string"},"consumer_id":{"type":"string"},"decoded_frames":{"minimum":0,"type":"integer"},"decoder_queue_depth":{"minimum":0,"type":"integer"},"dropped_frames":{"minimum":0,"type":"integer"},"frame_age_max_ms":{"type":"number"},"frame_age_ms":{"description":"Observed skewed latency; may be negative.","type":"number"},"interarrival_jitter_ms":{"type":"number"},"interval_ms":{"minimum":0,"type":"integer"},"last_keyframe_sequence":{"minimum":0,"type":"integer"},"last_sequence":{"minimum":0,"type":"integer"},"lost_frames":{"minimum":0,"type":"integer"},"received_frames":{"minimum":0,"type":"integer"},"since_last_keyframe_ms":{"minimum":0,"type":"integer"},"stream":{"type":"string"},"tier":{"type":"string"}},"required":["stream","consumer_id","interval_ms","received_frames","lost_frames","dropped_frames","decoded_frames","last_sequence"],"type":"object"},"StreamControl":{"description":"Internally tagged on `type`, snake_case. v1 wrapped it in Command<T> {id?, body}; the correlation id becomes the O7 call-metadata request_id.","oneOf":[{"properties":{"codec":{"type":"string"},"stream":{"type":"string"},"tier":{"type":"string"},"type":{"const":"open_stream"}},"required":["type","stream"],"type":"object"},{"properties":{"codec":{"type":"string"},"stream":{"type":"string"},"tier":{"type":"string"},"type":{"const":"close_stream"}},"required":["type","stream"],"type":"object"},{"properties":{"stream":{"type":"string"},"tier":{"type":"string"},"type":{"const":"request_keyframe"}},"required":["type","stream"],"type":"object"}]},"StreamDescriptor":{"description":"Capability-bearing catalogue entry (#507): native geometry and the tiers on offer, without opening the stream.","properties":{"active":{"type":"boolean"},"codecs":{"items":{"type":"string"},"type":"array"},"description":{"type":"string"},"fps":{"type":"number"},"height":{"minimum":0,"type":"integer"},"stream":{"type":"string"},"tiers":{"items":{"$ref":"#/$defs/TierSpec"},"type":"array"},"width":{"minimum":0,"type":"integer"}},"required":["stream","codecs","active"],"type":"object"},"StreamDiscoveryReport":{"properties":{"discovered":{"items":{"$ref":"#/$defs/DiscoveredStream"},"type":"array"},"methods":{"items":{"type":"string"},"type":"array"},"timestamp":{"type":"integer"}},"required":["timestamp"],"type":"object"},"StreamEnd":{"properties":{"reason":{"$ref":"#/$defs/StreamEndReason"},"tier":{"description":"A ladder rung's name, or `preview`.","type":"string"}},"required":["tier","reason"],"type":"object"},"StreamEndReason":{"description":"Internally tagged on `type`, snake_case.","oneOf":[{"properties":{"type":{"enum":["closed","idle","superseded","shutdown","source_ended","stalled"]}},"required":["type"],"type":"object"},{"properties":{"message":{"type":"string"},"node":{"type":"string"},"type":{"const":"failed"}},"required":["type","message"],"type":"object"},{"properties":{"message":{"type":"string"},"type":{"const":"failed_open"}},"required":["type","message"],"type":"object"}]},"StreamStatus":{"properties":{"last_end":{"$ref":"#/$defs/StreamEnd"},"open":{"type":"boolean"},"stream":{"description":"Repeats the key's {stream} (migration debt).","type":"string"},"tiers":{"items":{"$ref":"#/$defs/TierStatus"},"type":"array"}},"required":["stream","open"],"type":"object"},"TierApplied":{"properties":{"bitrate_kbps":{"minimum":0,"type":"integer"},"fps":{"minimum":0,"type":"integer"},"height":{"minimum":0,"type":"integer"},"width":{"minimum":0,"type":"integer"}},"required":["width","height","fps","bitrate_kbps"],"type":"object"},"TierSpec":{"properties":{"bitrate_kbps":{"minimum":0,"type":"integer"},"fps":{"minimum":0,"type":"integer"},"max_height":{"minimum":0,"type":"integer"},"name":{"type":"string"}},"required":["name","fps","bitrate_kbps"],"type":"object"},"TierStatus":{"properties":{"applied":{"$ref":"#/$defs/TierApplied"},"tier":{"type":"string"},"viewers":{"minimum":0,"type":"integer"}},"required":["tier","applied","viewers"],"type":"object"}},"$id":"zs.parallax.v1.json","$schema":"https://json-schema.org/draft/2020-12/schema"},"kind":"jsonschema"}}}