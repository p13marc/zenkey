://json-schema.org/draft/2020-12/schema"},"kind":"jsonschema"},"sha256:510038950a2e12b87e8fcc87d4c48d5b0aa11884fc5fc01d32507337ff195f6b":{"data":{"$comment":"SNMP documents for zs.snmp.v1 (device services) and zs.snmp_poller.v1 (the poller service). Faithful to zensight-common/src/interfaces.rs, event.rs, outlet.rs, discovery.rs and targets.rs. Fields that repeat the key's service (device) are kept and flagged as migration debt.","$defs":{"DiscoveredDevice":{"properties":{"address":{"type":"string"},"credentials":{"description":"A credential NAME into the host's file config, never a secret.","type":"string"},"matched_profiles":{"items":{"type":"string"},"type":"array"},"suggested":{"description":"Suggested target name, which would become the device service's name.","type":"string"},"sys_descr":{"type":"string"},"sys_name":{"type":"string"},"sys_object_id":{"type":"string"}},"required":["address","suggested"],"type":"object"},"DiscoveryReport":{"properties":{"discovered":{"items":{"$ref":"#/$defs/DiscoveredDevice"},"type":"array"},"scanned":{"minimum":0,"type":"integer"},"timestamp":{"type":"integer"}},"required":["timestamp","scanned"],"type":"object"},"EventRecord":{"description":"A translated trap or inform (zensight-common/src/event.rs). `id` repeats the key's occurrence; `source` and `protocol` repeat the service (migration debt).","properties":{"alert_key":{"type":"string"},"fields":{"additionalProperties":{"type":"string"},"description":"Translated varbinds plus notification metadata.","type":"object"},"id":{"description":"Lowercase ULID, equal to the key's {occurrence}.","type":"string"},"kind":{"description":"trap/<trap name>.","type":"string"},"protocol":{"description":"v1 Protocol enum token (snmp).","type":"string"},"severity":{"enum":["info","warning","critical"],"type":"string"},"source":{"type":"string"},"summary":{"type":"string"},"timestamp":{"type":"integer"}},"required":["id","timestamp","source","protocol","kind","severity","summary"],"type":"obje