// A runnable config against a bus that is not there: the transport half
// of the open fork (exit 1), not the config half (exit 2). No service of
// its own, so the case reads the same on a host with no machine id.
{
  bus: { zenoh_config: "tests/cmd/fixtures/dead-bus.json5" },
  rules: [{ name: "drops", rule: "dropped", sinks: ["hook"] }],
  sinks: { hook: { kind: "webhook", url: "https://hooks.example.org/z" } },
  publish: false,
}
