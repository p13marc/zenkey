// The lab router under allow, hand-edited (link.v1 0.4, F-120): the face's subject also selected by tcp, ground narrowed to its face, radio-b narrowed off udp (check-face.trycmd).
{
  mode: "router",
// zenohd access control, generated by `zenctl acl gen` (zk2 spec §11).
// namespace ""; default_permission allow; 6 subject(s), 18 rule(s), 5 polic(y/ies).
// Compiled from radio.v1@sha256:aec974a6730ebb9fac54a773734cf3dd0542024dc7c79c52ef61dab3f435f30b: regenerate on every contract revision (§11.2).
// Field names: zenoh 1.10 (zenoh-config-1.10.1/src/lib.rs: AclConfig, AclConfigRule,
// AclMessage, InterceptorFlow, AclConfigSubjects, AclConfigPolicyEntry). Merge at the
// router config's top level; rules, subjects and policies are all required. Subjects
// are bound by usrpwd user names (transport/auth/usrpwd) or certificate CNs (mTLS),
// never zids (§11.3). Access control is enforced per hop, and the running block is not
// observable on the bus (§11.3): `zenctl acl gen --check --against` reads this file.
// ! allow_posture: under default_permission allow, zenoh evaluates no allow rule, so each grant is compiled into denies of its complement, from the contracts given (regenerate on every revision). Deny works by inclusion: a put on a wildcard key is in none and reaches subscribers (R6 discards it), and a wildcard call is in none either, so an operation that allows fan-out executes on every provider for a principal never granted it, only its answers denied (O2 refuses the others). A session matching no subject has no policy and is allowed everything, so authentication must refuse it (§11.2, §11.3)
access_control: {
  enabled: true,
  default_permission: "allow",  // §11.2: allow rules are not evaluated; grants compile to denies of their complement
  rules: [
    // deny_admin_space: #684 (F-80, spec amendment 0.12): the routers serve the admin space themselves, so no principal has a reason to declare a queryable under `@/**`; one that does can answer a tool's admin-space read, and turn a check from unobservable into a false clean. Deny works by inclusion: `@/**` covers `@/<zid>/router`. The admin space is never namespaced
    { id: "deny-admin-space", permission: "deny", flows: ["ingress"],
      messages: ["declare_queryable"],
      key_exprs: ["@/**"] },
    // deny_write (radio-a): §11.2 under allow: Own's complement, every other enrolled service's writes, serving and tokens. A put on a wildcard key is in no deny and gets through: R6 discards it at the consumer (§11.3)
    { id: "deny-write:radio-a", permission: "deny", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/radio-b/**", "zk2/lab/radio-b/*/@stream/**", "zk2/lab/radio-b/*/@state/**", "zk2/lab/radio-b/*/@op/**", "zk2/lab/radio-b/@zk/**"] },
    // deny_read (radio-a): §11.2 under allow: the surfaces of other services this principal's grants do not name, from the contracts given. Deny works by inclusion (§11.3): a selector wider than every deny is in none
    { id: "deny-read:radio-a", permission: "deny", flows: ["ingress"],
      messages: ["declare_subscriber", "query", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/lab/radio-b/radio.v1/@op/reset", "zk2/lab/radio-b/radio.v1/@stream/frames", "zk2/lab/radio-b/radio.v1/@stream/raw", "zk2/lab/radio-b/radio.v1/events/change/*", "zk2/lab/radio-b/radio.v1/events/fault/*", "zk2/lab/radio-b/radio.v1/state/oper", "zk2/lab/radio-b/radio.v1/state/peers/*", "zk2/lab/radio-b/radio.v1/stream/air/dropped_total", "zk2/lab/radio-b/radio.v1/stream/air/frames_total", "zk2/lab/radio-b/@zk/**"] },
    // deny_receive (radio-a): §11.2 under allow, egress: the same complement toward this principal. A put, a token and a value reply are checked against their own key, so a wildcard subscription or GET does not escape it (measured, #612 FJ7)
    { id: "deny-receive:radio-a", permission: "deny", flows: ["egress"],
      messages: ["put", "delete", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/radio-b/radio.v1/@op/reset", "zk2/lab/radio-b/radio.v1/@stream/frames", "zk2/lab/radio-b/radio.v1/@stream/raw", "zk2/lab/radio-b/radio.v1/events/change/*", "zk2/lab/radio-b/radio.v1/events/fault/*", "zk2/lab/radio-b/radio.v1/state/oper", "zk2/lab/radio-b/radio.v1/state/peers/*", "zk2/lab/radio-b/radio.v1/stream/air/dropped_total", "zk2/lab/radio-b/radio.v1/stream/air/frames_total", "zk2/lab/radio-b/@zk/**"] },
    // deny_write (radio-b): §11.2 under allow: Own's complement, every other enrolled service's writes, serving and tokens. A put on a wildcard key is in no deny and gets through: R6 discards it at the consumer (§11.3)
    { id: "deny-write:radio-b", permission: "deny", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/radio-a/**", "zk2/lab/radio-a/*/@stream/**", "zk2/lab/radio-a/*/@state/**", "zk2/lab/radio-a/*/@op/**", "zk2/lab/radio-a/@zk/**"] },
    // deny_read (radio-b): §11.2 under allow: the surfaces of other services this principal's grants do not name, from the contracts given. Deny works by inclusion (§11.3): a selector wider than every deny is in none
    { id: "deny-read:radio-b", permission: "deny", flows: ["ingress"],
      messages: ["declare_subscriber", "query", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/lab/radio-a/radio.v1/@op/reset", "zk2/lab/radio-a/radio.v1/@stream/frames", "zk2/lab/radio-a/radio.v1/@stream/raw", "zk2/lab/radio-a/radio.v1/events/change/*", "zk2/lab/radio-a/radio.v1/events/fault/*", "zk2/lab/radio-a/radio.v1/state/oper", "zk2/lab/radio-a/radio.v1/state/peers/*", "zk2/lab/radio-a/radio.v1/stream/air/dropped_total", "zk2/lab/radio-a/radio.v1/stream/air/frames_total", "zk2/lab/radio-a/@zk/**"] },
    // deny_receive (radio-b): §11.2 under allow, egress: the same complement toward this principal. A put, a token and a value reply are checked against their own key, so a wildcard subscription or GET does not escape it (measured, #612 FJ7)
    { id: "deny-receive:radio-b", permission: "deny", flows: ["egress"],
      messages: ["put", "delete", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/radio-a/radio.v1/@op/reset", "zk2/lab/radio-a/radio.v1/@stream/frames", "zk2/lab/radio-a/radio.v1/@stream/raw", "zk2/lab/radio-a/radio.v1/events/change/*", "zk2/lab/radio-a/radio.v1/events/fault/*", "zk2/lab/radio-a/radio.v1/state/oper", "zk2/lab/radio-a/radio.v1/state/peers/*", "zk2/lab/radio-a/radio.v1/stream/air/dropped_total", "zk2/lab/radio-a/radio.v1/stream/air/frames_total", "zk2/lab/radio-a/@zk/**"] },
    // deny_write (local): §11.2 under allow: Own's complement, every other enrolled service's writes, serving and tokens. A put on a wildcard key is in no deny and gets through: R6 discards it at the consumer (§11.3)
    { id: "deny-write:local", permission: "deny", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/radio-a/**", "zk2/lab/radio-a/*/@stream/**", "zk2/lab/radio-a/*/@state/**", "zk2/lab/radio-a/*/@op/**", "zk2/lab/radio-a/@zk/**", "zk2/lab/radio-b/**", "zk2/lab/radio-b/*/@stream/**", "zk2/lab/radio-b/*/@state/**", "zk2/lab/radio-b/*/@op/**", "zk2/lab/radio-b/@zk/**"] },
    // deny_write (ground): §11.2 under allow: Own's complement, every other enrolled service's writes, serving and tokens. A put on a wildcard key is in no deny and gets through: R6 discards it at the consumer (§11.3)
    { id: "deny-write:ground", permission: "deny", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/radio-a/**", "zk2/lab/radio-a/*/@stream/**", "zk2/lab/radio-a/*/@state/**", "zk2/lab/radio-a/*/@op/**", "zk2/lab/radio-a/@zk/**", "zk2/lab/radio-b/**", "zk2/lab/radio-b/*/@stream/**", "zk2/lab/radio-b/*/@state/**", "zk2/lab/radio-b/*/@op/**", "zk2/lab/radio-b/@zk/**"] },
    // face_presence (ground): link.v1 §2.6, §8.5: no `@zk` traffic across a constrained face, never omitted. Bindings resolve statically (R7), bundles are held on each side, and presence never crosses; `**` matches zero chunks, so the contract keys are included
    { id: "face:radio:zk", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/**/@zk/**"] },
    // face_adv (ground): link.v1 §2.6: across a face an exposed resource is read live, never with history: advanced publication's tokens are presence of publishers, and its replay is bounded by no face's rate
    { id: "face:radio:adv", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/**/@adv/**"] },
    // face_admin (ground): link.v1 §2.6: the routers' admin space, never namespaced; a check that needs it runs on the near side, and across the face it is unobservable
    { id: "face:radio:admin", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["@/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:stream:radio.v1", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/radio.v1/stream/air/frames_total/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:@stream:radio.v1", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/radio.v1/@stream/raw/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:state:radio.v1", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/radio.v1/state/peers/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:@state", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/@state/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:events:radio.v1", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/radio.v1/events/change/**"] },
    // deny_write (ground-router): §11.2 under allow: Own's complement, every other enrolled service's writes, serving and tokens. A put on a wildcard key is in no deny and gets through: R6 discards it at the consumer (§11.3)
    { id: "deny-write:ground-router", permission: "deny", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/radio-a/**", "zk2/lab/radio-a/*/@stream/**", "zk2/lab/radio-a/*/@state/**", "zk2/lab/radio-a/*/@op/**", "zk2/lab/radio-a/@zk/**", "zk2/lab/radio-b/**", "zk2/lab/radio-b/*/@stream/**", "zk2/lab/radio-b/*/@state/**", "zk2/lab/radio-b/*/@op/**", "zk2/lab/radio-b/@zk/**"] },
  ],
  subjects: [
    // link.v1 §2.4 (0.3, F-118): zenoh ties no credential to a link, so a subject bound by a user name or a CN alone matches that principal's session over a face too; each principal's subject is selected by the link protocols outside the faces whose far principal it is not; under allow, each face has a subject of its own, in its far principal's policy, since a session matching no subject is allowed everything.
    { id: "radio-a", usernames: ["radio-a"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs lab/radio-a
    { id: "radio-b", usernames: ["radio-b"], link_protocols: ["tcp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs lab/radio-b
    { id: "local", usernames: ["local"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs tool.console
    { id: "ground", usernames: ["ground"], link_protocols: ["unixsock-stream"] },  // runs tool.console
    { id: "ground-router", usernames: ["ground-router"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs tool.console
    { id: "face:radio", link_protocols: ["unixsock-stream", "tcp"] },  // every session over the face's transports (link.v1 §2.4)
  ],
  policies: [
    { id: "radio-a", rules: ["deny-write:radio-a", "deny-read:radio-a", "deny-receive:radio-a", "deny-admin-space"],
      subjects: ["radio-a"] },
    { id: "radio-b", rules: ["deny-write:radio-b", "deny-read:radio-b", "deny-receive:radio-b", "deny-admin-space"],
      subjects: ["radio-b"] },
    { id: "local", rules: ["deny-write:local", "deny-admin-space"],
      subjects: ["local"] },
    { id: "ground", rules: ["deny-write:ground", "face:radio:zk", "face:radio:adv", "face:radio:admin", "face:radio:stream:radio.v1", "face:radio:@stream:radio.v1", "face:radio:state:radio.v1", "face:radio:@state", "face:radio:events:radio.v1", "deny-admin-space"],
      subjects: ["ground", "face:radio"] },
    { id: "ground-router", rules: ["deny-write:ground-router", "deny-admin-space"],
      subjects: ["ground-router"] },
  ],
},
// Field names: zenoh 1.10 (DownsamplingItemConf, DownsamplingRuleConf). One item per
// constrained face, selected by link protocol, never by interface (link.v1 §2.14).
// link.v1 §2.8: at most one put per crossing stream key per interval toward the far side, egress, put only so a delete still crosses; one rule per concrete key, since zenoh gives each rule one timer.
downsampling: [
  // face radio: 2 rule(s) at 1 Hz
  { id: "radio", link_protocols: ["unixsock-stream"], flows: ["egress"], messages: ["put"],
    rules: [
      { key_expr: "zk2/lab/radio-a/radio.v1/@stream/frames", freq: 1 },
      { key_expr: "zk2/lab/radio-a/radio.v1/stream/air/dropped_total", freq: 1 },
    ] },
],
// Face radio: the far side (ground) attaches as a client of this router (link.v1 §2.5):
// it receives only the declarations its interests ask for, and the face's denies
// keep @zk, @adv, the admin space and every push that does not cross off it.
}
