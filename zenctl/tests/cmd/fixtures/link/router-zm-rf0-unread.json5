  ],
  subjects: [
    // link.v1 §2.4 (0.3, F-118): zenoh ties no credential to a link, so a subject bound by a user name or a CN alone matches that principal's session over a face too; each principal's subject is selected by the link protocols outside the faces whose far principal it is not; under deny, a session matching no subject is granted nothing.
    { id: "rf-node", usernames: ["rf-node"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "unixsock-dgram", "vsock", "ws"] },  // runs h-3fa9c2d41b7e/rf0
    { id: "lora-node", usernames: ["lora-node"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "unixsock-dgrm", "vsock", "ws"] },  // runs h-c2a95e41d7f0/lora0
    { id: "sat-node", usernames: ["sat-node"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "unixsock-dgram", "vsock", "ws"] },  // runs h-71c0e2a9d4b3/sat0
    { id: "local", usernames: ["local"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "unixsock-dgram", "vsock", "ws"] },  // runs tool.console
    { id: "ground", usernames: ["ground"] },  // runs tool.console
    { id: "ground-gateway", usernames: ["ground-gateway"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "unixsock-dgram", "vsock", "ws"] },  // runs tool.console
  ],
  policies: [
    { id: "rf-node", rules: ["own-in:h-3fa9c2d41b7e/rf0", "own-out:h-3fa9c2d41b7e/rf0", "contracts-in", "contracts-out"],
      subjects: ["rf-node"] },
    { id: "lora-node", rules: ["own-in:h-c2a95e41d7f0/lora0", "own-out:h-c2a95e41d7f0/lora0", "contracts-in", "contracts-out"],
      subjects: ["lora-node"] },
    { id: "sat-node", rules: ["own-in:h-71c0e2a9d4b3/sat0", "own-out:h-71c0e2a9d4b3/sat0", "contracts-in", "contracts-out"],
      subjects: ["sat-node"] },
    { id: "local", rules: ["consume-in:tool.console", "consume-out:tool.console", "presence-in:tool.console", "presence-out:tool.console", "call-in:tool.console", "call-out:tool.console", "contracts-in", "contracts-out"],
      subjects: ["local"] },
    { id: "ground", rules: ["consume-in:tool.console", "consume-out:tool.console", "call-in:tool.console", "call-out:tool.console", "face:rf:zk", "face:rf:adv", "face:rf:admin", "face:rf:stream:config.v1", "face:rf:stream:freshness.v2", "face:rf:stream:health.v1", "face:rf:stream:modem.v3", "face:rf:@stream", "face:rf:state", "face:rf:@state", "face:rf:events:config.v1", "face:rf:events:health.v1", "face:rf:events:modem.v3"],
      subjects: ["ground"] },
    { id: "ground-gateway", rules: ["consume-in:tool.console", "consume-out:tool.console", "presence-in:tool.console", "presence-out:tool.console", "call-in:tool.console", "call-out:tool.console", "contracts-in", "contracts-out"],
      subjects: ["ground-gateway"] },
  ],
},
// The transport this router runs (link.v2 §2.16, §2.18), from the face policy: binding zm-1.10.2-r1.
// zenoh reads it once per process, for every link it holds. Merge it into the
// config's own `transport` (auth, TLS) by hand: a JSON5 object holds one `transport`
// key. Both ends run one lease and keep_alive, which are not negotiated: the far end's
// block is `zenctl acl gen --far-config`, and `zenctl check face --peer-config` compares
// the two.
transport: {
  link: {
    tx: {
      lease: 240000,  // ms; a keep-alive every 60000 ms when idle
      keep_alive: 4,
      sequence_number_resolution: "16bit",
      batch_size: 222,
      queue: { congestion_control: { block: { wait_before_close: 240000000 } } },  // µs, at least the lease
    },
  },
  unicast: { open_timeout: 10000, accept_timeout: 10000 },  // ms
},
routing: { interests: { timeout: 10000 } },  // ms
// Face rf: the far side (ground) attaches as a client of this router (link.v1 §2.5):
// it receives only the declarations its interests ask for, and the face's denies
// keep @zk, @adv, the admin space and every push that does not cross off it.
}
