// The lab router, hand-edited (link.v1 0.4, F-120): local's subject bound to ground and local, and a subject on the face bound to nobody in local's policy (check-face.trycmd).
{
  mode: "router",
// zenohd access control, generated by `zenctl acl gen` (zk2 spec §11).
// namespace ""; default_permission deny; 5 subject(s), 26 rule(s), 5 polic(y/ies).
// Compiled from radio.v1@sha256:aec974a6730ebb9fac54a773734cf3dd0542024dc7c79c52ef61dab3f435f30b: regenerate on every contract revision (§11.2).
// Field names: zenoh 1.10 (zenoh-config-1.10.1/src/lib.rs: AclConfig, AclConfigRule,
// AclMessage, InterceptorFlow, AclConfigSubjects, AclConfigPolicyEntry). Merge at the
// router config's top level; rules, subjects and policies are all required. Subjects
// are bound by usrpwd user names (transport/auth/usrpwd) or certificate CNs (mTLS),
// never zids (§11.3). Access control is enforced per hop, and the running block is not
// observable on the bus (§11.3): `zenctl acl gen --check --against` reads this file.
access_control: {
  enabled: true,
  default_permission: "deny",  // §11.2: grants compile to allow rules (RECOMMENDED)
  rules: [
    // own (lab/radio-a): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:lab/radio-a", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/radio-a/**", "zk2/lab/radio-a/*/@stream/**", "zk2/lab/radio-a/*/@state/**", "zk2/lab/radio-a/*/@op/**", "zk2/lab/radio-a/@zk/**"] },
    // own (lab/radio-a): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:lab/radio-a", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/radio-a/**", "zk2/lab/radio-a/*/@stream/**", "zk2/lab/radio-a/*/@state/**", "zk2/lab/radio-a/*/@op/**", "zk2/lab/radio-a/@zk/**"] },
    // fan_in (lab/radio-a): §11.2, §3.3 (0.27): the descriptor's GET and subscription ride the presence grant (0.14) and, unlike a liveliness read, travel toward the provider, which serves its descriptor: every presence selector that intersects this provider's `@zk` subtree, and that its own patterns do not include, is granted here. Without it a wildcard descriptor read, a doctor's or an inspecting tool's, is refused at the provider (measured, #748). No reply rule: a descriptor is a value reply, checked against its own key
    { id: "fan-in-presence:lab/radio-a", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/*/@zk/**"] },
    // fan_in (lab/radio-a): §11.2: egress is checked by inclusion against the query's or subscription's own key expression, so every consumer or caller selector that intersects this provider's keys, and that its own patterns do not include, is granted here; without it a fan-in GET gets 0 replies (spike S14)
    { id: "fan-in:lab/radio-a", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/*/radio.v1/@stream/**", "zk2/lab/*/radio.v1/events/**", "zk2/lab/*/radio.v1/state/**", "zk2/lab/*/radio.v1/stream/**", "zk2/lab/*/radio.v1/@op/reset"] },
    // fan_in_reply (lab/radio-a): §11.2: the same selectors for this provider's ingress reply, refusals included. An error reply (O2's fanout_forbidden, O3's unavailable) carries no key and is checked against the selector; a value reply is checked against its own key, which Own includes (measured, #612 FJ7)
    { id: "fan-in-reply:lab/radio-a", permission: "allow", flows: ["ingress"],
      messages: ["reply"],
      key_exprs: ["zk2/lab/*/radio.v1/@stream/**", "zk2/lab/*/radio.v1/events/**", "zk2/lab/*/radio.v1/state/**", "zk2/lab/*/radio.v1/stream/**", "zk2/lab/*/radio.v1/@op/reset"] },
    // own (lab/radio-b): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:lab/radio-b", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/radio-b/**", "zk2/lab/radio-b/*/@stream/**", "zk2/lab/radio-b/*/@state/**", "zk2/lab/radio-b/*/@op/**", "zk2/lab/radio-b/@zk/**"] },
    // own (lab/radio-b): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:lab/radio-b", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/radio-b/**", "zk2/lab/radio-b/*/@stream/**", "zk2/lab/radio-b/*/@state/**", "zk2/lab/radio-b/*/@op/**", "zk2/lab/radio-b/@zk/**"] },
    // fan_in (lab/radio-b): §11.2, §3.3 (0.27): the descriptor's GET and subscription ride the presence grant (0.14) and, unlike a liveliness read, travel toward the provider, which serves its descriptor: every presence selector that intersects this provider's `@zk` subtree, and that its own patterns do not include, is granted here. Without it a wildcard descriptor read, a doctor's or an inspecting tool's, is refused at the provider (measured, #748). No reply rule: a descriptor is a value reply, checked against its own key
    { id: "fan-in-presence:lab/radio-b", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/*/@zk/**"] },
    // fan_in (lab/radio-b): §11.2: egress is checked by inclusion against the query's or subscription's own key expression, so every consumer or caller selector that intersects this provider's keys, and that its own patterns do not include, is granted here; without it a fan-in GET gets 0 replies (spike S14)
    { id: "fan-in:lab/radio-b", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/*/radio.v1/@stream/**", "zk2/lab/*/radio.v1/events/**", "zk2/lab/*/radio.v1/state/**", "zk2/lab/*/radio.v1/stream/**", "zk2/lab/*/radio.v1/@op/reset"] },
    // fan_in_reply (lab/radio-b): §11.2: the same selectors for this provider's ingress reply, refusals included. An error reply (O2's fanout_forbidden, O3's unavailable) carries no key and is checked against the selector; a value reply is checked against its own key, which Own includes (measured, #612 FJ7)
    { id: "fan-in-reply:lab/radio-b", permission: "allow", flows: ["ingress"],
      messages: ["reply"],
      key_exprs: ["zk2/lab/*/radio.v1/@stream/**", "zk2/lab/*/radio.v1/events/**", "zk2/lab/*/radio.v1/state/**", "zk2/lab/*/radio.v1/stream/**", "zk2/lab/*/radio.v1/@op/reset"] },
    // consume (tool.console): §11.1 Consume: subscribe or GET on what the bindings name, one selector per bound provider (R1), R2's parameter bindings applied
    { id: "consume-in:tool.console", permission: "allow", flows: ["ingress"],
      messages: ["declare_subscriber", "query"],
      key_exprs: ["zk2/lab/*/radio.v1/@stream/**", "zk2/lab/*/radio.v1/events/**", "zk2/lab/*/radio.v1/state/**", "zk2/lab/*/radio.v1/stream/**"] },
    // consume (tool.console): §11.1 Consume, egress: the samples and replies those selectors receive
    { id: "consume-out:tool.console", permission: "allow", flows: ["egress"],
      messages: ["put", "delete", "reply"],
      key_exprs: ["zk2/lab/*/radio.v1/@stream/**", "zk2/lab/*/radio.v1/events/**", "zk2/lab/*/radio.v1/state/**", "zk2/lab/*/radio.v1/stream/**"] },
    // presence (tool.console): §11.1 Consume, Call and Tool (0.8, 0.14, 0.27), §8.1, §3.3: liveliness reads and the descriptor's GET and subscription on the `@zk` subtree of each service bound, called or inspected. A refused read is answered complete and empty, so a reader the grants refuse would attribute silence to absence (§11.3)
    { id: "presence-in:tool.console", permission: "allow", flows: ["ingress"],
      messages: ["declare_liveliness_subscriber", "liveliness_query", "query", "declare_subscriber"],
      key_exprs: ["zk2/lab/*/@zk/**"] },
    // presence (tool.console): §11.1 (0.8, 0.14, 0.27), §8.1, §3.3, egress: the tokens and the descriptors those reads receive
    { id: "presence-out:tool.console", permission: "allow", flows: ["egress"],
      messages: ["liveliness_token", "reply", "put"],
      key_exprs: ["zk2/lab/*/@zk/**"] },
    // call (tool.console): §11.1 Call: query on the specific `…/@op/<op>` keys called
    { id: "call-in:tool.console", permission: "allow", flows: ["ingress"],
      messages: ["query"],
      key_exprs: ["zk2/lab/*/radio.v1/@op/reset"] },
    // call (tool.console): §11.1 Call, egress: the replies, a server's refusal included (O2, O3)
    { id: "call-out:tool.console", permission: "allow", flows: ["egress"],
      messages: ["reply"],
      key_exprs: ["zk2/lab/*/radio.v1/@op/reset"] },
    // contracts: §11.1: contract bundles are open, any principal may hold or fetch `zk2/@zk/contract/**`, because the hash is the check (§8.4)
    { id: "contracts-in", permission: "allow", flows: ["ingress"],
      messages: ["declare_queryable", "reply", "query"],
      key_exprs: ["zk2/@zk/contract/**"] },
    // contracts: §11.1: contract bundles are open, any principal may hold or fetch `zk2/@zk/contract/**`, because the hash is the check (§8.4)
    { id: "contracts-out", permission: "allow", flows: ["egress"],
      messages: ["query", "reply"],
      key_exprs: ["zk2/@zk/contract/**"] },
    // face_presence (ground): link.v1 §2.6, §8.5: no `@zk` traffic across a constrained face, never omitted. Bindings resolve statically (R7), bundles are held on each side, and presence never crosses; `**` matches zero chunks, so the contract keys are included
    { id: "face:radio:zk", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/**/@zk/**"] },
    // face_adv (ground): link.v1 §2.6: across a face an exposed resource is read live, never with history: advanced publication's tokens are presence of publishers, and its replay is bounded by no face's rate
    { id: "face:radio:adv", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/**/@adv/**"] },
    // face_admin (ground): link.v1 §2.6: the routers' admin space, never namespaced; a check that needs it runs on the near side, and across the face it is unobservable
    { id: "face:radio:admin", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["@/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:stream:radio.v1", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/radio.v1/stream/air/frames_total/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:@stream:radio.v1", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/radio.v1/@stream/raw/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:state:radio.v1", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/radio.v1/state/peers/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:@state", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/@state/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:radio:events:radio.v1", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/radio.v1/events/change/**"] },
  ],
  subjects: [
    // link.v1 §2.4 (0.3, F-118): zenoh ties no credential to a link, so a subject bound by a user name or a CN alone matches that principal's session over a face too; each principal's subject is selected by the link protocols outside the faces whose far principal it is not; under deny, a session matching no subject is granted nothing.
    { id: "radio-a", usernames: ["radio-a"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs lab/radio-a
    { id: "radio-b", usernames: ["radio-b"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs lab/radio-b
    { id: "local", usernames: ["ground", "local"] },  // runs tool.console
    { id: "ground", usernames: ["ground"] },  // runs tool.console
    { id: "face:radio", link_protocols: ["unixsock-stream"] },
    { id: "ground-router", usernames: ["ground-router"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs tool.console
  ],
  policies: [
    { id: "radio-a", rules: ["own-in:lab/radio-a", "own-out:lab/radio-a", "fan-in-presence:lab/radio-a", "fan-in:lab/radio-a", "fan-in-reply:lab/radio-a", "contracts-in", "contracts-out"],
      subjects: ["radio-a"] },
    { id: "radio-b", rules: ["own-in:lab/radio-b", "own-out:lab/radio-b", "fan-in-presence:lab/radio-b", "fan-in:lab/radio-b", "fan-in-reply:lab/radio-b", "contracts-in", "contracts-out"],
      subjects: ["radio-b"] },
    { id: "local", rules: ["consume-in:tool.console", "consume-out:tool.console", "presence-in:tool.console", "presence-out:tool.console", "call-in:tool.console", "call-out:tool.console", "contracts-in", "contracts-out"],
      subjects: ["local", "face:radio"] },
    { id: "ground", rules: ["consume-in:tool.console", "consume-out:tool.console", "call-in:tool.console", "call-out:tool.console", "face:radio:zk", "face:radio:adv", "face:radio:admin", "face:radio:stream:radio.v1", "face:radio:@stream:radio.v1", "face:radio:state:radio.v1", "face:radio:@state", "face:radio:events:radio.v1"],
      subjects: ["ground"] },
    { id: "ground-router", rules: ["consume-in:tool.console", "consume-out:tool.console", "presence-in:tool.console", "presence-out:tool.console", "call-in:tool.console", "call-out:tool.console", "contracts-in", "contracts-out"],
      subjects: ["ground-router"] },
  ],
},
// Field names: zenoh 1.10 (DownsamplingItemConf, DownsamplingRuleConf). One item per
// constrained face, selected by link protocol, never by interface (link.v1 §2.14).
// link.v1 §2.8: at most one put per crossing stream key per interval toward the far side, egress, put only so a delete still crosses; one rule per concrete key, since zenoh gives each rule one timer.
downsampling: [
  // face radio: 2 rule(s) at 1 Hz
  { id: "radio", link_protocols: ["unixsock-stream"], flows: ["egress"], messages: ["put"],
    rules: [
      { key_expr: "zk2/lab/radio-a/radio.v1/@stream/frames", freq: 1 },
      { key_expr: "zk2/lab/radio-a/radio.v1/stream/air/dropped_total", freq: 1 },
    ] },
],
// Face radio: the far side (ground) attaches as a client of this router (link.v1 §2.5):
// it receives only the declarations its interests ask for, and the face's denies
// keep @zk, @adv, the admin space and every push that does not cross off it.
}
