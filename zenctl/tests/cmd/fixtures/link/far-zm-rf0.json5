// The ground side of zenoh-modem's RF face: a gateway client, its transport `acl gen --far-config` (check-face.trycmd, #1044).
{
  mode: "client",
// The far end's transport, generated by `zenctl acl gen --far-config` (link.v2 §2.18):
// the far router's config, or the gateway client's session config, across face rf (far ground).
// The transport the far end runs (link.v2 §2.16, §2.18), from the face policy.
// zenoh reads it once per process, for every link it holds. Merge it into the
// config's own `transport` (auth, TLS) by hand: a JSON5 object holds one `transport`
// key. Both ends run one lease and keep_alive, which are not negotiated: `zenctl check
// face --peer-config` compares this one with the router's.
transport: {
  link: {
    tx: {
      lease: 240000,  // ms; a keep-alive every 60000 ms when idle
      keep_alive: 4,
      sequence_number_resolution: "16bit",
      batch_size: 222,
      queue: { congestion_control: { block: { wait_before_close: 240000000 } } },  // µs, at least the lease
    },
  },
  unicast: { open_timeout: 10000, accept_timeout: 10000 },  // ms
},
routing: { interests: { timeout: 10000 } },  // ms
}
