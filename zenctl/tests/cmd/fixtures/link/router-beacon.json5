// The lab router of beacon.face.toml, its block the plan acl gen wrote from beacon.enrollment.toml (check-face.trycmd, #1145).
{
  mode: "router",
// zenohd access control, generated by `zenctl acl gen` (zk2 spec §11).
// namespace ""; default_permission deny; 3 subject(s), 23 rule(s), 3 polic(y/ies).
// Compiled from beacon.v2@sha256:509312be4a5dbb58a3dca8956fb3cb9a1ae75d12673c8a034c604050b7776a23, freshness.v2@sha256:9e07704d114d5124a0d177a003c125ec01b80da0f3f1bad594ab300e0ae1e5d1: regenerate on every contract revision (§11.2).
// Field names: zenoh 1.10 (zenoh-config-1.10.1/src/lib.rs: AclConfig, AclConfigRule,
// AclMessage, InterceptorFlow, AclConfigSubjects, AclConfigPolicyEntry). Merge at the
// router config's top level; rules, subjects and policies are all required. Subjects
// are bound by usrpwd user names (transport/auth/usrpwd) or certificate CNs (mTLS),
// never zids (§11.3). Access control is enforced per hop, and the running block is not
// observable on the bus (§11.3): `zenctl acl gen --check --against` reads this file.
access_control: {
  enabled: true,
  default_permission: "deny",  // §11.2: grants compile to allow rules (RECOMMENDED)
  rules: [
    // own (lab/b1): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:lab/b1", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/b1/**", "zk2/lab/b1/*/@stream/**", "zk2/lab/b1/*/@state/**", "zk2/lab/b1/*/@op/**", "zk2/lab/b1/@zk/**"] },
    // own (lab/b1): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:lab/b1", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/b1/**", "zk2/lab/b1/*/@stream/**", "zk2/lab/b1/*/@state/**", "zk2/lab/b1/*/@op/**", "zk2/lab/b1/@zk/**"] },
    // fan_in (lab/b1): §11.2, §3.3 (0.27): the descriptor's GET and subscription ride the presence grant (0.14) and, unlike a liveliness read, travel toward the provider, which serves its descriptor: every presence selector that intersects this provider's `@zk` subtree, and that its own patterns do not include, is granted here. Without it a wildcard descriptor read, a doctor's or an inspecting tool's, is refused at the provider (measured, #748). No reply rule: a descriptor is a value reply, checked against its own key
    { id: "fan-in-presence:lab/b1", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/*/@zk/**"] },
    // fan_in (lab/b1): §11.2: egress is checked by inclusion against the query's or subscription's own key expression, so every consumer or caller selector that intersects this provider's keys, and that its own patterns do not include, is granted here; without it a fan-in GET gets 0 replies (spike S14)
    { id: "fan-in:lab/b1", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/*/beacon.v2/state/**", "zk2/lab/*/freshness.v2/stream/heartbeat/beacon.v2", "zk2/lab/*/freshness.v2/stream/heartbeats/link"] },
    // fan_in_reply (lab/b1): §11.2: the same selectors for this provider's ingress reply, refusals included. An error reply (O2's fanout_forbidden, O3's unavailable) carries no key and is checked against the selector; a value reply is checked against its own key, which Own includes (measured, #612 FJ7)
    { id: "fan-in-reply:lab/b1", permission: "allow", flows: ["ingress"],
      messages: ["reply"],
      key_exprs: ["zk2/lab/*/beacon.v2/state/**", "zk2/lab/*/freshness.v2/stream/heartbeat/beacon.v2", "zk2/lab/*/freshness.v2/stream/heartbeats/link"] },
    // own (lab/b2): §11.1 Own: the service puts, deletes, serves and declares tokens under its prefix, each verbatim subtree spelled out because `**` never crosses one (§1.3), its `@adv` subtrees where it uses advanced publication (§2.5); reply covers its answers to queries on its own keys
    { id: "own-in:lab/b2", permission: "allow", flows: ["ingress"],
      messages: ["put", "delete", "declare_queryable", "reply", "liveliness_token"],
      key_exprs: ["zk2/lab/b2/**", "zk2/lab/b2/*/@stream/**", "zk2/lab/b2/*/@state/**", "zk2/lab/b2/*/@op/**", "zk2/lab/b2/@zk/**"] },
    // own (lab/b2): §11.1 Own, egress: queries and subscriptions on its own keys reach it, so a queryable is asked and a publisher learns of interest (spike S14)
    { id: "own-out:lab/b2", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/b2/**", "zk2/lab/b2/*/@stream/**", "zk2/lab/b2/*/@state/**", "zk2/lab/b2/*/@op/**", "zk2/lab/b2/@zk/**"] },
    // fan_in (lab/b2): §11.2, §3.3 (0.27): the descriptor's GET and subscription ride the presence grant (0.14) and, unlike a liveliness read, travel toward the provider, which serves its descriptor: every presence selector that intersects this provider's `@zk` subtree, and that its own patterns do not include, is granted here. Without it a wildcard descriptor read, a doctor's or an inspecting tool's, is refused at the provider (measured, #748). No reply rule: a descriptor is a value reply, checked against its own key
    { id: "fan-in-presence:lab/b2", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/*/@zk/**"] },
    // fan_in (lab/b2): §11.2: egress is checked by inclusion against the query's or subscription's own key expression, so every consumer or caller selector that intersects this provider's keys, and that its own patterns do not include, is granted here; without it a fan-in GET gets 0 replies (spike S14)
    { id: "fan-in:lab/b2", permission: "allow", flows: ["egress"],
      messages: ["query", "declare_subscriber"],
      key_exprs: ["zk2/lab/*/beacon.v2/state/**", "zk2/lab/*/freshness.v2/stream/heartbeat/beacon.v2", "zk2/lab/*/freshness.v2/stream/heartbeats/link"] },
    // fan_in_reply (lab/b2): §11.2: the same selectors for this provider's ingress reply, refusals included. An error reply (O2's fanout_forbidden, O3's unavailable) carries no key and is checked against the selector; a value reply is checked against its own key, which Own includes (measured, #612 FJ7)
    { id: "fan-in-reply:lab/b2", permission: "allow", flows: ["ingress"],
      messages: ["reply"],
      key_exprs: ["zk2/lab/*/beacon.v2/state/**", "zk2/lab/*/freshness.v2/stream/heartbeat/beacon.v2", "zk2/lab/*/freshness.v2/stream/heartbeats/link"] },
    // consume (tool.console): §11.1 Consume: subscribe or GET on what the bindings name, one selector per bound provider (R1), R2's parameter bindings applied, and (0.86) each bound provider's heartbeat covering a bound interface that uses freshness.v2, where the binding consumes one of its collections, and its owner heartbeat key for each class those collections have (§7.5, freshness.v2 §2.4, §2.5)
    { id: "consume-in:tool.console", permission: "allow", flows: ["ingress"],
      messages: ["declare_subscriber", "query"],
      key_exprs: ["zk2/lab/*/beacon.v2/state/**", "zk2/lab/*/freshness.v2/stream/heartbeat/beacon.v2", "zk2/lab/*/freshness.v2/stream/heartbeats/link"] },
    // consume (tool.console): §11.1 Consume, egress: the samples and replies those selectors receive
    { id: "consume-out:tool.console", permission: "allow", flows: ["egress"],
      messages: ["put", "delete", "reply"],
      key_exprs: ["zk2/lab/*/beacon.v2/state/**", "zk2/lab/*/freshness.v2/stream/heartbeat/beacon.v2", "zk2/lab/*/freshness.v2/stream/heartbeats/link"] },
    // contracts: §11.1: contract bundles are open, any principal may hold or fetch `zk2/@zk/contract/**`, because the hash is the check (§8.4)
    { id: "contracts-in", permission: "allow", flows: ["ingress"],
      messages: ["declare_queryable", "reply", "query"],
      key_exprs: ["zk2/@zk/contract/**"] },
    // contracts: §11.1: contract bundles are open, any principal may hold or fetch `zk2/@zk/contract/**`, because the hash is the check (§8.4)
    { id: "contracts-out", permission: "allow", flows: ["egress"],
      messages: ["query", "reply"],
      key_exprs: ["zk2/@zk/contract/**"] },
    // face_presence (ground): link.v1 §2.6, §8.5: no `@zk` traffic across a constrained face, never omitted. Bindings resolve statically (R7), bundles are held on each side, and presence never crosses; `**` matches zero chunks, so the contract keys are included
    { id: "face:rf:zk", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/**/@zk/**"] },
    // face_adv (ground): link.v1 §2.6: across a face an exposed resource is read live, never with history: advanced publication's tokens are presence of publishers, and its replay is bounded by no face's rate
    { id: "face:rf:adv", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["zk2/**/@adv/**"] },
    // face_admin (ground): link.v1 §2.6: the routers' admin space, never namespaced; a check that needs it runs on the near side, and across the face it is unobservable
    { id: "face:rf:admin", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["@/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:rf:stream:beacon.v2", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/beacon.v2/stream/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:rf:stream:freshness.v2", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/freshness.v2/stream/heartbeats/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:rf:@stream", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/@stream/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:rf:state:freshness.v2", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/freshness.v2/state/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:rf:@state", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/@state/**"] },
    // face_exposure (ground): link.v1 §2.7: the pushes (put, delete, declare_subscriber) of every resource that does not cross, wholesale per kind token when nothing of it crosses, else per interface, carved around what is exposed. Requests cross by grant (§2.9)
    { id: "face:rf:events", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["zk2/*/*/*/events/**"] },
  ],
  subjects: [
    // link.v1 §2.4 (0.3, F-118): zenoh ties no credential to a link, so a subject bound by a user name or a CN alone matches that principal's session over a face too; each principal's subject is selected by the link protocols outside the faces whose far principal it is not; under deny, a session matching no subject is granted nothing.
    { id: "b1", usernames: ["b1"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs lab/b1
    { id: "b2", usernames: ["b2"], link_protocols: ["tcp", "udp", "tls", "quic", "serial", "unixpipe", "vsock", "ws"] },  // runs lab/b2
    { id: "ground", usernames: ["ground"] },  // runs tool.console
  ],
  policies: [
    { id: "b1", rules: ["own-in:lab/b1", "own-out:lab/b1", "fan-in-presence:lab/b1", "fan-in:lab/b1", "fan-in-reply:lab/b1", "contracts-in", "contracts-out"],
      subjects: ["b1"] },
    { id: "b2", rules: ["own-in:lab/b2", "own-out:lab/b2", "fan-in-presence:lab/b2", "fan-in:lab/b2", "fan-in-reply:lab/b2", "contracts-in", "contracts-out"],
      subjects: ["b2"] },
    { id: "ground", rules: ["consume-in:tool.console", "consume-out:tool.console", "face:rf:zk", "face:rf:adv", "face:rf:admin", "face:rf:stream:beacon.v2", "face:rf:stream:freshness.v2", "face:rf:@stream", "face:rf:state:freshness.v2", "face:rf:@state", "face:rf:events"],
      subjects: ["ground"] },
  ],
},
// Face rf: the far side (ground) attaches as a client of this router (link.v1 §2.5):
// it receives only the declarations its interests ask for, and the face's denies
// keep @zk, @adv, the admin space and every push that does not cross off it.
}
