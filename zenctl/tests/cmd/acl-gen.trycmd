access_control: {
  enabled: true,
  default_permission: "allow",  // node-global: a face-scoped deny lives under a permissive default (RFC 09 §4)
  rules: [
    // face-deny-detail: RFC 09 §4 (v1.43): the `host` subjects by name, because a sibling is `link` or `fleet` and deny is evaluated first — the carve-out for what crosses has to be an absence from this list
    { id: "deny-telemetry-netlink-detail", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"],
      key_exprs: ["zensight/v1/*/telemetry/netlink/sockets/tcp/connlat_us_p50"] },
    // face-deny-detail: RFC 09 §4 (v1.43): the `host` subjects by name, because a sibling is `link` or `fleet` and deny is evaluated first — the carve-out for what crosses has to be an absence from this list
    { id: "deny-telemetry-sysinfo-detail", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"],
      key_exprs: ["zensight/v1/*/telemetry/sysinfo/memory/used"] },
    // face-deny-plane: RFC 09 §3 fact 6 (v1.38): a plane is denied by the widest pattern that can reach it — the verbatim chunk must be spelled by any query that reaches the plane, and `**` on either side includes every spelling around it; a producer-scoped literal is crossed by a broader query
    { id: "deny-rpc", permission: "deny", flows: ["egress", "ingress"],
      messages: ["query", "reply", "declare_queryable", "put", "delete", "declare_subscriber"],
      key_exprs: ["**/@rpc/**"] },
    // face-deny-plane: RFC 09 §4: a stream or a bulk fetch has no business on a constrained link; the widest spelling, for fact 6
    { id: "deny-media", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"],
      key_exprs: ["**/@media/**"] },
    // face-deny-plane: RFC 09 §4: a stream or a bulk fetch has no business on a constrained link; the widest spelling, for fact 6
    { id: "deny-blob", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"],
      key_exprs: ["**/@blob/**"] },
    // face-deny-admin: RFC 09 §4: the admin space and the advanced-tier sidecars never cross a constrained link — every rule above is rooted at v1, so without this the whole admin surface would be permitted by the permissive default
    { id: "deny-adminspace", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["@/**", "**/@adv/**"] },
    // face-deny-plane: RFC 09 §4 (v1.49): a face principal's subject repeats every face deny, because any matching subject's allow wins — of the @rpc plane, the legs no call uses; query, reply and declare_queryable are carved to its grants below
    { id: "deny-rpc-legs", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber"],
      key_exprs: ["**/@rpc/**"] },
    // writes: RFC 09 §3 (v1.43): a per-resource write grant — the resource is a path chunk, so the grant is a literal prefix; the deny below is carved around it, because deny wins and a carve-out has to be an absence
    { id: "writes-ops", permission: "allow",
      messages: ["query"],
      key_exprs: ["zensight/v1/*/@rpc/systemd/expectations/set"] },
    // no-remote-actions: RFC 09 §3 (v1.43): the declared writes this principal's grants do not include — carved, because deny wins and a grant cannot punch a hole
    { id: "no-remote-actions-ops", permission: "deny",
      messages: ["query"],
      key_exprs: ["zensight/v1/*/@rpc/gnmi/artifact/cancel", "zensight/v1/*/@rpc/gnmi/artifact/request", "zensight/v1/*/@rpc/logs/artifact/cancel", "zensight/v1/*/@rpc/logs/artifact/request", "zensight/v1/*/@rpc/logs/filter/set", "zensight/v1/*/@rpc/modbus/artifact/cancel", "zensight/v1/*/@rpc/modbus/artifact/request", "zensight/v1/*/@rpc/netflow/artifact/cancel", "zensight/v1/*/@rpc/netflow/artifact/request", "zensight/v1/*/@rpc/netlink/artifact/cancel", "zensight/v1/*/@rpc/netlink/artifact/request", "zensight/v1/*/@rpc/netlink/collection/set", "zensight/v1/*/@rpc/netlink/expectations/set", "zensight/v1/*/@rpc/netring/artifact/cancel", "zensight/v1/*/@rpc/netring/artifact/request", "zensight/v1/*/@rpc/netring/capture_disk/set", "zensight/v1/*/@rpc/netring/capture_filter/set", "zensight/v1/*/@rpc/netring/detectors/set", "zensight/v1/*/@rpc/netring/threat_intel/set", "zensight/v1/*/@rpc/parallax/artifact/cancel", "zensight/v1/*/@rpc/parallax/artifact/request", "zensight/v1/*/@rpc/parallax/stream/set", "zensight/v1/*/@rpc/snmp/artifact/cancel", "zensight/v1/*/@rpc/snmp/artifact/request", "zensight/v1/*/@rpc/sysinfo/artifact/cancel", "zensight/v1/*/@rpc/sysinfo/artifact/request", "zensight/v1/*/@rpc/systemd/action/set", "zensight/v1/*/@rpc/systemd/artifact/cancel", "zensight/v1/*/@rpc/systemd/artifact/request", "zensight/v1/@catalog/@rpc/catalog/link", "zensight/v1/@catalog/@rpc/catalog/unlink"] },
  ],
  subjects: [  // the enrollment: transport identity ↔ origin (RFC 03 §4 D6)
    { id: "constrained-link", link_protocols: ["unixsock-stream"] },  // link
    { id: "ops", usernames: ["ops"], link_protocols: ["unixsock-stream"] },  // console
  ],
  policies: [
    { id: "constrained-link-mgmt", rules: ["deny-telemetry-netlink-detail", "deny-telemetry-sysinfo-detail", "deny-rpc", "deny-media", "deny-blob", "deny-adminspace"],
      subjects: ["constrained-link"] },
    { id: "ops", rules: ["deny-telemetry-netlink-detail", "deny-telemetry-sysinfo-detail", "deny-media", "deny-blob", "deny-adminspace", "deny-rpc-legs", "writes-ops", "no-remote-actions-ops"],
      subjects: ["ops"] },
  ],
},
