  tc-h-20609002f7b6  user tc-h-20609002f7b6  h-20609002f7b6/tc              own-in:h-20609002f7b6/tc, own-out:h-20609002f7b6/tc, fan-in:h-20609002f7b6/tc, fan-in-reply:h-20609002f7b6/tc, contracts-in, contracts-out
  tcgui-frontend     user tcgui-frontend     h-0123456789ab/tcgui-frontend  own-in:h-0123456789ab/tcgui-frontend, own-out:h-0123456789ab/tcgui-frontend, consume-in:h-0123456789ab/tcgui-frontend, consume-out:h-0123456789ab/tcgui-frontend, presence-in:h-0123456789ab/tcgui-frontend, presence-out:h-0123456789ab/tcgui-frontend, call-in:h-0123456789ab/tcgui-frontend, call-out:h-0123456789ab/tcgui-frontend, contracts-in, contracts-out

