// ! face_cuts_plane: 100 procedure(s) marked `link` or `fleet` are cut with the @rpc plane, which is denied whole because a sibling is `host`: catalog/link, catalog/unlink, catalog/names, catalog/introspect, gnmi/introspect, gnmi/artifact/request, gnmi/artifact/cancel, gnmi/artifact/status, logs/introspect, logs/artifact/request, logs/artifact/cancel, logs/artifact/status, logs/events, logs/filter, logs/filter/set, modbus/introspect, modbus/artifact/request, modbus/artifact/cancel, modbus/artifact/status, netflow/introspect, netflow/artifact/request, netflow/artifact/cancel, netflow/artifact/status, netflow/flows, netlink/introspect, netlink/artifact/request, netlink/artifact/cancel, netlink/artifact/status, netlink/expectations, netlink/expectations/set, netlink/collection, netlink/collection/set, netlink/routes, netlink/neighbors, netlink/sockets, netlink/addresses, netlink/events, netlink/route_changes, netlink/tc, netlink/xfrm, netlink/nft, netlink/bandwidth, netlink/retransmits, netlink/connections, netring/introspect, netring/artifact/request, netring/artifact/cancel, netring/artifact/status, netring/capture_disk, netring/capture_disk/set, netring/detectors, netring/detectors/set, netring/capture_filter, netring/capture_filter/set, netring/threat_intel, netring/threat_intel/set, netring/flows, netring/tls, netring/talkers, netring/matrix, netring/elephant_flows, netring/dns, netring/http, netring/quic, netring/ssh, netring/encrypted_dns, netring/ja4h, netring/assets, netring/ipfix, netring/captures, netring/bandwidth, parallax/introspect, parallax/artifact/request, parallax/artifact/cancel, parallax/artifact/status, parallax/streams, parallax/stream/set, snmp/introspect, snmp/artifact/request, snmp/artifact/cancel, snmp/artifact/status, sysinfo/introspect, sysinfo/artifact/request, sysinfo/artifact/cancel, sysinfo/artifact/status, sysinfo/processes, sysinfo/latency, systemd/introspect, systemd/artifact/request, systemd/artifact/cancel, systemd/artifact/status, systemd/expectations, systemd/action, systemd/action/set, systemd/units, systemd/failed, systemd/unit, systemd/timers, systemd/events, systemd/cgroups (RFC 09 §3 fact 6)
access_control: {
  enabled: true,
  default_permission: "allow",  // node-global: a face-scoped deny lives under a permissive default (RFC 09 §4)
  rules: [
    // face-deny-detail: RFC 09 §4 (v1.43): the `host` subjects by name, because a sibling is `link` or `fleet` and deny is evaluated first — the carve-out for what crosses has to be an absence from this list
    { id: "deny-telemetry-netlink-detail", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"],
      key_exprs: ["zensight/v1/*/telemetry/netlink/sockets/tcp/connlat_us_p50"] },
    // face-deny-detail: RFC 09 §4 (v1.43): the `host` subjects by name, because a sibling is `link` or `fleet` and deny is evaluated first — the carve-out for what crosses has to be an absence from this list
    { id: "deny-telemetry-sysinfo-detail", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"],
      key_exprs: ["zensight/v1/*/telemetry/sysinfo/memory/used"] },
    // face-deny-plane: RFC 09 §3 fact 6 (v1.38): a plane is denied by the widest pattern that can reach it — the verbatim chunk must be spelled by any query that reaches the plane, and `**` on either side includes every spelling around it; a producer-scoped literal is crossed by a broader query
    { id: "deny-rpc", permission: "deny", flows: ["egress", "ingress"],
      messages: ["query", "reply", "declare_queryable", "put", "delete", "declare_subscriber"],
      key_exprs: ["**/@rpc/**"] },
    // face-deny-plane: RFC 09 §4: a stream or a bulk fetch has no business on a constrained link; the widest spelling, for fact 6
    { id: "deny-media", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"],
      key_exprs: ["**/@media/**"] },
    // face-deny-plane: RFC 09 §4: a stream or a bulk fetch has no business on a constrained link; the widest spelling, for fact 6
    { id: "deny-blob", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"],
      key_exprs: ["**/@blob/**"] },
    // face-deny-admin: RFC 09 §4: the admin space and the advanced-tier sidecars never cross a constrained link — every rule above is rooted at v1, so without this the whole admin surface would be permitted by the permissive default
    { id: "deny-adminspace", permission: "deny", flows: ["egress", "ingress"],
      messages: ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
      key_exprs: ["@/**", "**/@adv/**"] },
  ],
  subjects: [  // the enrollment: transport identity ↔ origin (RFC 03 §4 D6)
    { id: "constrained-link", link_protocols: ["unixsock-stream"] },  // link
  ],
  policies: [
    { id: "constrained-link-mgmt", rules: ["deny-telemetry-netlink-detail", "deny-telemetry-sysinfo-detail", "deny-rpc", "deny-media", "deny-blob", "deny-adminspace"],
      subjects: ["constrained-link"] },
  ],
},
