{"key":"prod/v1/h-9b2e4c7a1d05/state/sysinfo/health","row":"changed","timestamp":["7f3b2a1c00000001/ab12","7f3b2a1c00000009/ef56"],"value":{"changes":[{"new":"node","old":"db","op":"changed","path":"source"}],"truncated":0}}
